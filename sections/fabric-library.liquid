{%- liquid
  assign scheme = section.settings.color_scheme.id
-%}

<div class="section fabric-library">
  <div class="fabric-library__grid color-{{ scheme }}">
    {%- if section.settings.show_panel -%}
      <div class="fabric-library__panel">
        <div class="fabric-library__panel-text">
          {%- if section.settings.panel_eyebrow != blank -%}
            <p class="label">{{ section.settings.panel_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.panel_heading != blank -%}
            <h2 class="fabric-library__panel-heading h1">{{ section.settings.panel_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.panel_text != blank -%}
            <div class="rte">{{ section.settings.panel_text }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.panel_points != blank -%}
          <div class="fabric-library__points">{{ section.settings.panel_points }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fabric-library__library">
      <div class="section-heading">
        <h2 class="section-heading__title h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
      <ul class="fabric-library__swatches" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign swatch_style = ''
            if block.settings.image
              assign swatch_image_url = block.settings.image | image_url: width: 400
              assign swatch_style = 'background-image: url(' | append: swatch_image_url | append: ');'
            elsif block.settings.color != blank
              assign swatch_style = 'background-color: ' | append: block.settings.color | append: ';'
            endif
          -%}
          <li class="fabric-library__swatch" {{ block.shopify_attributes }}>
            <span class="fabric-library__sample" style="{{ swatch_style }}"></span>
            <span class="fabric-library__name">{{ block.settings.name }}</span>
            {%- if block.settings.kind != blank -%}
              <span class="text-caption text-muted">{{ block.settings.kind }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% stylesheet %}
  .fabric-library {
    padding-inline: 16px;
  }

  .fabric-library .fabric-library__grid {
    background-color: transparent;
  }

  .fabric-library__grid {
    display: grid;
    gap: 16px;
  }

  .fabric-library__panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    min-height: 440px;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius-media);
    background-color: var(--color-accent);
    color: var(--color-accent-label);
  }

  .fabric-library__panel-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fabric-library__panel-text .rte {
    max-width: 440px;
  }

  .fabric-library__points ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fabric-library__points li {
    padding-block: 12px;
    border-top: 1px solid currentcolor;
  }

  .fabric-library__library {
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius-media);
    background-color: var(--color-tile);
  }

  .fabric-library__swatches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
    margin: 0;
  }

  .fabric-library__swatch {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .fabric-library__sample {
    display: block;
    aspect-ratio: 1;
    margin-bottom: 4px;
    border-radius: calc(var(--radius-media) / 2);
    background-color: var(--color-background);
    background-size: cover;
    background-position: center;
  }

  .fabric-library__name {
    font-size: 14px;
    line-height: 18px;
    font-weight: var(--font-body-weight-medium);
  }

  @media screen and (min-width: 750px) {
    .fabric-library__swatches {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .fabric-library__grid:has(.fabric-library__panel) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fabric-library__panel {
      min-height: 560px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.fabric_library.name",
  "class": "section-fabric-library",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "info": "t:sections.fabric_library.color_scheme_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.fabric_library.panel_header"
    },
    {
      "type": "checkbox",
      "id": "show_panel",
      "label": "t:sections.fabric_library.show_panel",
      "default": true
    },
    {
      "type": "text",
      "id": "panel_eyebrow",
      "label": "t:sections.rich_text.caption",
      "default": "Materials"
    },
    {
      "type": "inline_richtext",
      "id": "panel_heading",
      "label": "t:labels.heading",
      "default": "Built from solid oak"
    },
    {
      "type": "richtext",
      "id": "panel_text",
      "label": "t:labels.text",
      "default": "<p>Tell customers what your pieces are made of and why it lasts.</p>"
    },
    {
      "type": "richtext",
      "id": "panel_points",
      "label": "t:sections.fabric_library.panel_points",
      "info": "t:sections.fabric_library.panel_points_info",
      "default": "<ul><li>Responsibly sourced timber</li><li>Traditional joinery</li><li>Care kit included</li></ul>"
    },
    {
      "type": "header",
      "content": "t:sections.fabric_library.library_header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Fabrics and finishes"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "Order free samples"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "blocks": [
    {
      "type": "fabric",
      "name": "t:sections.fabric_library.blocks.fabric",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.fabric_library.blocks.image"
        },
        {
          "type": "color",
          "id": "color",
          "label": "t:sections.material_guide.blocks.swatch_color",
          "default": "#c8b49a"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.material_guide.blocks.name",
          "default": "Fabric"
        },
        {
          "type": "text",
          "id": "kind",
          "label": "t:sections.fabric_library.blocks.kind",
          "default": "Linen blend"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.fabric_library.name",
      "blocks": [
        {
          "type": "fabric",
          "settings": {
            "name": "Oat",
            "color": "#d8cbb5"
          }
        },
        {
          "type": "fabric",
          "settings": {
            "name": "Moss",
            "color": "#7d7a5c"
          }
        },
        {
          "type": "fabric",
          "settings": {
            "name": "Clay",
            "color": "#b07a5a"
          }
        }
      ]
    }
  ]
}
{% endschema %}
