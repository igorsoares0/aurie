{%- liquid
  assign collection = section.settings.collection
  assign index_columns = section.settings.index_columns | strip
  assign index_pairs = index_columns | split: ','
  capture index_template
    echo '52px 104px minmax(180px, 2fr)'
    for pair in index_pairs
      echo ' minmax(56px, 0.6fr)'
    endfor
    echo ' minmax(110px, 1.2fr) 150px'
  endcapture
  assign menu = section.settings.menu
-%}

<div class="section product-index color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="section-heading">
      <div class="section-heading__title">
        {%- if section.settings.heading != blank -%}
          <h2>{% render 'split-heading', text: section.settings.heading %}</h2>
        {%- endif -%}
        {%- if collection != blank -%}
          <span class="section-heading__count">{{ 'facets.product_count' | t: count: collection.all_products_count }}</span>
        {%- endif -%}
      </div>
      {%- if collection != blank and section.settings.link_label != blank -%}
        <a class="text-link" href="{{ collection.url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if menu.links.size > 0 -%}
      <nav class="product-index__menu" aria-label="{{ menu.title | escape }}">
        <ul class="chip-tabs" role="list">
          {%- for link in menu.links -%}
            <li><a class="chip-tabs__tab" href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <ul class="product-grid product-grid--index" role="list" style="--index-template: {{ index_template }};">
      <li class="product-grid__head label" aria-hidden="true">
        <span>{{ 'collections.index_number' | t }}</span>
        <span></span>
        <span>{{ 'collections.index_piece' | t }}</span>
        {%- for pair in index_pairs -%}
          <span>{{ pair | split: ':' | first | strip }}</span>
        {%- endfor -%}
        <span>{{ 'product.card.options' | t }}</span>
        <span>{{ 'collections.index_from' | t }}</span>
      </li>
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li class="product-grid__item">
            {% render 'product-card', product: product, sizes: '120px', heading_tag: 'h3', index_columns: index_columns, show_index: true %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="product-grid__item">
            <article class="product-card">
              <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'product-card__image placeholder-svg' }}</div>
              <div class="product-card__info">
                <div class="product-card__row">
                  <h3 class="product-card__name">{{ 'sections.featured_collection.placeholder' | t }}</h3>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if collection != blank and collection.all_products_count > section.settings.products_to_show -%}
      <div class="product-index__footer">
        <span class="figure-caption">
          {{- 'facets.showing' | t: shown: section.settings.products_to_show, total: collection.all_products_count -}}
        </span>
        <a class="button button--secondary" href="{{ collection.url }}">{{ 'sections.product_index.show_all' | t: count: collection.all_products_count }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-index__menu {
    margin-bottom: 16px;
  }

  .product-index__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_index.name",
  "class": "section-product-index",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "info": "t:labels.split_heading_info", "default": "Index" },
    { "type": "collection", "id": "collection", "label": "t:sections.product_index.collection" },
    { "type": "range", "id": "products_to_show", "label": "t:sections.product_index.products_to_show", "min": 4, "max": 24, "step": 1, "default": 8 },
    { "type": "text", "id": "index_columns", "label": "t:sections.main_collection.index_columns", "info": "t:sections.main_collection.index_columns_info", "default": "W: custom.width, D: custom.depth, H: custom.height" },
    { "type": "link_list", "id": "menu", "label": "t:sections.product_index.menu", "info": "t:sections.product_index.menu_info" },
    { "type": "text", "id": "link_label", "label": "t:sections.product_index.link_label", "default": "View all" }
  ],
  "presets": [
    { "name": "t:sections.product_index.name" }
  ]
}
{% endschema %}
