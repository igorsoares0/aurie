{%- liquid
  assign scheme = section.settings.color_scheme.id
  assign filled = false
  if scheme != 'scheme-1'
    assign filled = true
  endif
-%}

<div class="section video-section color-{{ scheme }}{% if filled %} section--filled{% endif %}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading{% if section.settings.full_width %} page-width{% endif %}">
        <h2 class="section-heading__title">{% render 'split-heading', text: section.settings.heading %}</h2>
      </div>
    {%- endif -%}

    <deferred-video class="video-section__frame{% if section.settings.full_width %} video-section__frame--full{% endif %}">
      {%- capture video_markup -%}
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, controls: true, playsinline: true, class: 'video-section__player' }}
        {%- elsif section.settings.video_url != blank -%}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe class="video-section__player" src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&rel=0" title="{{ section.settings.description | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
          {%- else -%}
            <iframe class="video-section__player" src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" title="{{ section.settings.description | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- endif -%}
        {%- endif -%}
      {%- endcapture -%}

      {%- if video_markup != blank -%}
        <template data-video>{{ video_markup }}</template>
      {%- endif -%}

      <button class="video-section__poster" type="button" data-play {% if video_markup == blank %}disabled{% endif %}>
        {%- assign poster = section.settings.cover_image | default: section.settings.video.preview_image -%}
        {%- if poster -%}
          {{
            poster
            | image_url: width: 2400
            | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'lazy', alt: '', class: 'video-section__image'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'video-section__image placeholder-svg' }}
        {%- endif -%}
        <span class="video-section__play">
          <span class="video-section__triangle" aria-hidden="true"></span>
          <span class="visually-hidden">{{ 'sections.video.play' | t: description: section.settings.description }}</span>
        </span>
      </button>
    </deferred-video>
  </div>
</div>

{% stylesheet %}
  .video-section__frame {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-media);
    background-color: var(--color-tile);
  }

  .video-section__frame--full {
    border-radius: 0;
  }

  .video-section__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .video-section__image,
  .video-section__player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .video-section__play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    border-radius: 9999px;
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .video-section__triangle {
    margin-left: 4px;
    border-block: 10px solid transparent;
    border-inline-start: 16px solid currentcolor;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('deferred-video')) {
    customElements.define(
      'deferred-video',
      class DeferredVideo extends HTMLElement {
        connectedCallback() {
          this.querySelector('[data-play]')?.addEventListener('click', () => this.load());
        }

        load() {
          const template = this.querySelector('template[data-video]');
          if (!template) return;
          const content = template.content.cloneNode(true);
          this.querySelector('[data-play]').remove();
          this.append(content);
          this.querySelector('video, iframe')?.focus();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.video.name",
  "class": "section-video",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.video.video_url",
      "info": "t:sections.video.video_url_info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.cover_image"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.description",
      "info": "t:sections.video.description_info",
      "default": "Video"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.video.full_width",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.name"
    }
  ]
}
{% endschema %}
