{%- liquid
  assign scheme = section.settings.color_scheme.id
  assign filled = false
  if scheme != 'scheme-1'
    assign filled = true
  endif

  case section.settings.image_ratio
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = 'auto'
  endcase
-%}

<div class="section image-with-text image-with-text--{{ section.settings.width }} color-{{ scheme }}{% if filled %} section--filled{% endif %}">
  <div class="image-with-text__grid image-with-text__grid--{{ section.settings.layout }}{% if section.settings.width == 'contained' %} page-width{% endif %}">
    <div class="image-with-text__media-wrap{% if section.settings.tag_text != blank %} image-with-text__media-wrap--tagged{% endif %}">
      <div class="image-with-text__media" style="--media-ratio: {{ ratio }};">
        {%- if section.settings.image -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              widths: '500, 750, 1000, 1500, 2000',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image.alt,
              class: 'image-with-text__image'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'image-with-text__image placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if section.settings.tag_text != blank -%}
        <span class="image-with-text__tag label">{{ section.settings.tag_text }}</span>
      {%- endif -%}
    </div>

    <div class="image-with-text__content image-with-text__content--{{ section.settings.content_alignment }} image-with-text__content--{{ section.settings.content_style }}">
      {%- assign in_button_row = false -%}
      {%- for block in section.blocks -%}
        {%- liquid
          # Consecutive buttons share one row; text links and other blocks get a line of their own
          assign is_row_button = false
          if block.type == 'button' and block.settings.style != 'link'
            assign is_row_button = true
          endif
          if is_row_button and in_button_row == false
            echo '<div class="image-with-text__buttons">'
            assign in_button_row = true
          elsif is_row_button == false and in_button_row
            echo '</div>'
            assign in_button_row = false
          endif
        -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="image-with-text__heading {{ block.settings.size }}" {{ block.shopify_attributes }}>
              {{- block.settings.heading -}}
            </h2>
          {%- when 'caption' -%}
            <p class="image-with-text__caption label text-muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'text' -%}
            <div class="image-with-text__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- liquid
              case block.settings.style
                when 'outline'
                  assign button_class = 'button button--secondary'
                when 'link'
                  assign button_class = 'text-link'
                else
                  assign button_class = 'button'
              endcase
            -%}
            <a class="image-with-text__button {{ button_class }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {{- block.settings.label -}}
            </a>
        {%- endcase -%}
      {%- endfor -%}
      {%- liquid
        if in_button_row
          echo '</div>'
        endif
      -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text__grid {
    display: grid;
  }

  .image-with-text__media-wrap {
    position: relative;
  }

  .image-with-text__media {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 360px;
    background-color: var(--color-tile);
  }

  .image-with-text--contained .image-with-text__media {
    aspect-ratio: var(--media-ratio);
    min-height: 0;
    border-radius: var(--radius-media);
  }

  .image-with-text__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text__media-wrap--tagged {
    padding: 24px;
  }

  .image-with-text__tag {
    position: absolute;
    top: 8px;
    left: 48px;
    padding: 10px 16px;
    background-color: var(--tag-color, #efe3b3);
    color: #161514;
  }

  .image-with-text__content {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 16px 12px;
    padding: 32px var(--page-margin);
  }

  /* Text links keep their own width, so their click area stays the size of the text */
  .image-with-text__content > :not(.text-link) {
    flex-basis: 100%;
  }

  .image-with-text__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: inherit;
    gap: 8px;
  }

  .image-with-text__content--center {
    justify-content: center;
    text-align: center;
  }

  /* The measure is set on the paragraphs: a narrow flex item would let buttons sit beside it */
  .image-with-text__content--center .image-with-text__text > * {
    max-width: 380px;
    margin-inline: auto;
  }

  .image-with-text__content--left {
    justify-content: flex-start;
  }

  .image-with-text__content--inline {
    align-items: baseline;
    column-gap: 24px;
  }

  .image-with-text__content--inline > * {
    flex-basis: auto;
  }

  .image-with-text__heading.h3 + .image-with-text__button.text-link {
    align-self: baseline;
  }

  .image-with-text--contained .image-with-text__grid {
    gap: 32px;
  }

  .image-with-text--contained .image-with-text__content {
    padding-inline: 0;
  }

  @media screen and (min-width: 750px) {
    .image-with-text__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .image-with-text--full .image-with-text__media {
      min-height: 560px;
    }

    .image-with-text__grid--image_second .image-with-text__media-wrap {
      order: 2;
    }

    .image-with-text--contained .image-with-text__grid {
      gap: 48px 80px;
      align-items: center;
    }

    .image-with-text__content {
      padding: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "class": "section-image-with-text",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_banner.image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image_with_text.layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image_with_text.layout_image_first"
        },
        {
          "value": "image_second",
          "label": "t:sections.image_with_text.layout_image_second"
        }
      ],
      "default": "image_second"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.image_with_text.width",
      "options": [
        {
          "value": "full",
          "label": "t:sections.image_with_text.width_full"
        },
        {
          "value": "contained",
          "label": "t:sections.image_with_text.width_contained"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.image_with_text.image_ratio",
      "options": [
        {
          "value": "portrait",
          "label": "t:sections.main_product.media_ratio_portrait"
        },
        {
          "value": "square",
          "label": "t:sections.main_product.media_ratio_square"
        },
        {
          "value": "landscape",
          "label": "t:sections.main_product.media_ratio_landscape"
        }
      ],
      "default": "landscape",
      "visible_if": "{{ section.settings.width == 'contained' }}"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "t:sections.image_with_text.tag_text",
      "info": "t:sections.image_with_text.tag_text_info"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.image_with_text.content_alignment",
      "options": [
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "left",
          "label": "t:options.alignment.left"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_style",
      "label": "t:sections.image_with_text.content_style",
      "options": [
        {
          "value": "stacked",
          "label": "t:sections.image_banner.content_layout_stacked"
        },
        {
          "value": "inline",
          "label": "t:sections.image_banner.content_layout_inline"
        }
      ],
      "default": "stacked"
    }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "t:sections.image_with_text.blocks.caption",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Materials"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:labels.heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Image with text"
        },
        {
          "type": "select",
          "id": "size",
          "label": "t:labels.heading_size",
          "options": [
            {
              "value": "h3",
              "label": "t:options.heading_size.small"
            },
            {
              "value": "h2",
              "label": "t:options.heading_size.medium"
            },
            {
              "value": "h1",
              "label": "t:options.heading_size.large"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:labels.text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection or story.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.image_with_text.blocks.button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.button_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.image_banner.button_style",
          "options": [
            {
              "value": "button",
              "label": "t:options.button_style.button"
            },
            {
              "value": "outline",
              "label": "t:options.button_style.outline"
            },
            {
              "value": "link",
              "label": "t:options.button_style.link"
            }
          ],
          "default": "link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
