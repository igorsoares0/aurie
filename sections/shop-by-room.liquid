{%- liquid
  assign scheme = section.settings.color_scheme.id
  assign filled = false
  if scheme != 'scheme-1'
    assign filled = true
  endif
-%}

<div class="section shop-by-room color-{{ scheme }}{% if filled %} section--filled{% endif %}">
  <div class="shop-by-room__inner">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading shop-by-room__heading">
        <h2 class="section-heading__title">{% render 'split-heading', text: section.settings.heading %}</h2>
      </div>
    {%- endif -%}

    <ul class="shop-by-room__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="shop-by-room__item" {{ block.shopify_attributes }}>
          <a class="room-tile" href="{{ block.settings.link | default: routes.collections_url }}">
            {%- if block.settings.image -%}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag:
                  widths: '500, 800, 1200, 1800',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: '',
                  class: 'room-tile__image'
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'room-tile__image placeholder-svg' }}
            {%- endif -%}
            <span class="room-tile__caption">
              <span class="room-tile__title">{{ block.settings.title }}</span>
              {%- if block.settings.subtitle != blank -%}
                <span class="room-tile__subtitle">{{ block.settings.subtitle }}</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .shop-by-room__inner {
    padding-inline: 16px;
  }

  .shop-by-room__heading {
    margin-inline: 16px;
  }

  .shop-by-room__grid {
    display: grid;
    gap: 16px;
    margin: 0;
  }

  .room-tile {
    position: relative;
    display: block;
    overflow: hidden;
    height: 100%;
    min-height: 312px;
    border-radius: var(--radius-media);
    background-color: var(--color-tile);
    text-decoration: none;
  }

  .room-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.45), transparent 50%);
  }

  .room-tile__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-medium) var(--ease);
  }

  @media (hover: hover) {
    .room-tile:hover .room-tile__image {
      transform: scale(1.03);
    }
  }

  .room-tile__caption {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 28px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #fff;
  }

  .room-tile__title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    text-transform: var(--font-heading-case);
    font-size: var(--font-h2-size);
    line-height: 1;
  }

  .room-tile__subtitle {
    font-size: var(--font-small-size);
  }

  @media screen and (min-width: 750px) {
    .shop-by-room__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 312px;
    }

    .shop-by-room__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }

    .shop-by-room__item:nth-child(2) {
      grid-column: span 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.shop_by_room.name",
  "class": "section-shop-by-room",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.split_heading_info",
      "default": "Shop | by room"
    }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "t:sections.shop_by_room.blocks.room",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image_banner.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.heading",
          "default": "Room"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "t:sections.shop_by_room.blocks.subtitle",
          "default": "Sofas, armchairs, side tables"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop_by_room.name",
      "blocks": [
        { "type": "room", "settings": { "title": "Living room" } },
        { "type": "room", "settings": { "title": "Bedroom" } },
        { "type": "room", "settings": { "title": "Dining" } },
        { "type": "room", "settings": { "title": "Workspace" } }
      ]
    }
  ]
}
{% endschema %}
