{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign card_sizes = '(min-width: 990px) calc((100vw - 120px) / ' | append: columns_desktop | append: '), (min-width: 750px) calc((100vw - 64px) / 3), calc((100vw - 36px) / ' | append: section.settings.columns_mobile | append: ')'

  assign default_view = blank
  if section.settings.show_view_switch
    assign default_view = section.settings.default_view
  endif
  assign index_columns = section.settings.index_columns | strip
  assign index_pairs = index_columns | split: ','
  capture index_template
    echo '52px 104px minmax(180px, 2fr)'
    for pair in index_pairs
      echo ' minmax(56px, 0.6fr)'
    endfor
    echo ' minmax(110px, 1.2fr) 150px'
  endcapture

  assign has_active_filters = false
  for filter in search.filters
    if filter.active_values.size > 0
      assign has_active_filters = true
    elsif filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign has_active_filters = true
      endif
    endif
  endfor
-%}

<facet-filters
  class="main-search color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
>
  <div class="main-search__head page-width">
    <h1 class="main-search__title label text-muted">{{ 'search.title' | t }}</h1>

    <form class="main-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="MainSearchInput-{{ section.id }}">{{ 'search.placeholder' | t }}</label>
      <input
        class="field main-search__input"
        id="MainSearchInput-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button class="button" type="submit">{{ 'search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      <p class="main-search__summary figure-caption" role="status">
        {%- if search.results_count == 0 and has_active_filters == false -%}
          {{ 'search.no_results_html' | t: terms: search.terms }}
        {%- else -%}
          {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>

  {%- if search.performed -%}
    <div class="results-layout results-layout--{{ section.settings.filter_layout }} page-width">
      {%- paginate search.results by section.settings.results_per_page -%}
        {%- if search.results_count > 0 or has_active_filters -%}
          {% render 'facets',
            results: search,
            layout: section.settings.filter_layout,
            section_id: section.id,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            products_count: search.results_count,
            default_view: default_view
          %}
        {%- endif -%}

        <div class="results" data-facets-part="results">
          {%- if search.results.size > 0 -%}
            <ul
              class="product-grid{% if default_view == 'index' %} product-grid--index{% endif %}"
              role="list"
              style="--columns-desktop: {{ columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }}; --index-template: {{ index_template }};"
              data-product-grid
            >
              {%- if default_view != blank -%}
                <li class="product-grid__head label" aria-hidden="true">
                  <span>{{ 'collections.index_number' | t }}</span>
                  <span></span>
                  <span>{{ 'collections.index_piece' | t }}</span>
                  {%- for pair in index_pairs -%}
                    <span>{{ pair | split: ':' | first | strip }}</span>
                  {%- endfor -%}
                  <span>{{ 'product.card.options' | t }}</span>
                  <span>{{ 'collections.index_from' | t }}</span>
                </li>
              {%- endif -%}
              {%- for result in search.results -%}
                <li class="product-grid__item">
                  {%- if result.object_type == 'product' -%}
                    {%- if default_view != blank -%}
                      {% render 'product-card', product: result, sizes: card_sizes, heading_tag: 'h2', index_columns: index_columns, show_index: true %}
                    {%- else -%}
                      {% render 'product-card', product: result, sizes: card_sizes, heading_tag: 'h2' %}
                    {%- endif -%}
                  {%- else -%}
                    {% render 'search-result-card', result: result, heading_tag: 'h2' %}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>

            {%- if section.settings.pagination_style == 'load_more' -%}
              {%- if paginate.next -%}
                {%- assign shown_count = paginate.current_offset | plus: search.results.size -%}
                <div class="results__more" data-load-more-wrapper>
                  <p class="text-small text-muted" role="status">
                    {{- 'facets.showing' | t: shown: shown_count, total: paginate.items -}}
                  </p>
                  <a class="button button--secondary" href="{{ paginate.next.url }}" data-load-more>
                    {{- 'facets.load_more' | t -}}
                  </a>
                </div>
              {%- endif -%}
            {%- else -%}
              {% render 'pagination', paginate: paginate %}
            {%- endif -%}
          {%- elsif has_active_filters -%}
            <div class="results__empty">
              <h2>{{ 'facets.empty_filtered_title' | t }}</h2>
              <p>{{ 'facets.empty_filtered_text' | t }}</p>
              <a class="button" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}" data-facets-link>
                {{- 'facets.clear_filters' | t -}}
              </a>
            </div>
          {%- else -%}
            <div class="results__empty">
              <h2>{{ 'search.empty_title' | t }}</h2>
              <p>{{ 'search.empty_text' | t }}</p>
              <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
            </div>
          {%- endif -%}
        </div>
      {%- endpaginate -%}
    </div>
  {%- endif -%}
</facet-filters>

{%- for block in section.blocks -%}
  {%- if block.type == '@app' -%}
    <div class="app-block page-width">{% render block %}</div>
  {%- elsif block.type == 'custom_liquid' -%}
    <div class="app-block page-width" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
  {%- endif -%}
{%- endfor -%}

{% stylesheet %}
  .main-search {
    display: block;
    padding-block: 32px var(--section-spacing);
  }

  .main-search__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  /* The query is the page's title: large type on a strong underline */
  .main-search__form {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--color-text);
  }

  .main-search__input {
    flex: 1;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: var(--font-h1-size);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .main-search__input:focus-visible {
    outline-offset: 6px;
  }

  .main-search__input::-webkit-search-cancel-button {
    cursor: pointer;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_search.name",
  "class": "section-main-search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:sections.main_search.results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.main_collection.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main_collection.columns_mobile_one"
        },
        {
          "value": "2",
          "label": "t:sections.main_collection.columns_mobile_two"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:sections.main_collection.pagination_style",
      "options": [
        {
          "value": "numbers",
          "label": "t:sections.main_collection.pagination_style_numbers"
        },
        {
          "value": "load_more",
          "label": "t:sections.main_collection.pagination_style_load_more"
        }
      ],
      "default": "numbers"
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.index_header"
    },
    {
      "type": "checkbox",
      "id": "show_view_switch",
      "label": "t:sections.main_collection.show_view_switch",
      "default": true
    },
    {
      "type": "select",
      "id": "default_view",
      "label": "t:sections.main_collection.default_view",
      "options": [
        {
          "value": "plates",
          "label": "t:sections.main_collection.default_view_plates"
        },
        {
          "value": "index",
          "label": "t:sections.main_collection.default_view_index"
        }
      ],
      "default": "index"
    },
    {
      "type": "text",
      "id": "index_columns",
      "label": "t:sections.main_collection.index_columns",
      "info": "t:sections.main_collection.index_columns_info",
      "default": "W: custom.width, D: custom.depth, H: custom.height"
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.filters_header"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection.enable_filtering",
      "info": "t:sections.main_collection.enable_filtering_info",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "t:sections.main_collection.filter_layout",
      "options": [
        {
          "value": "horizontal",
          "label": "t:sections.main_collection.filter_layout_horizontal"
        },
        {
          "value": "vertical",
          "label": "t:sections.main_collection.filter_layout_vertical"
        },
        {
          "value": "drawer",
          "label": "t:sections.main_collection.filter_layout_drawer"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_collection.enable_sorting",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom_liquid",
      "name": "t:blocks.custom_liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:blocks.custom_liquid.label",
          "info": "t:blocks.custom_liquid.info"
        }
      ]
    }
  ]
}
{% endschema %}
