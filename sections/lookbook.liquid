{%- liquid
  assign scheme = section.settings.color_scheme.id
  assign filled = false
  if scheme != 'scheme-1'
    assign filled = true
  endif
-%}

<div class="section lookbook color-{{ scheme }}{% if filled %} section--filled{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading">
        <h2 class="section-heading__title">{% render 'split-heading', text: section.settings.heading %}</h2>
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="lookbook__list" role="list">
      {%- for block in section.blocks -%}
        <li class="lookbook__item" {{ block.shopify_attributes }}>
          <figure class="lookbook__figure">
            <div class="lookbook__media">
              {%- if block.settings.image -%}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '400, 600, 800, 1200, 1600',
                    sizes: '(min-width: 990px) 40vw, 80vw',
                    loading: 'lazy',
                    alt: block.settings.image.alt,
                    class: 'lookbook__image'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook__image placeholder-svg' }}
              {%- endif -%}
            </div>
            <figcaption class="lookbook__caption">
              <span class="label text-muted">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {%- if block.settings.title != blank -%}
                <span class="lookbook__title">{{ block.settings.title }}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
              {%- endif -%}
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .lookbook__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(78%, 1fr);
    gap: var(--grid-gap);
    margin: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .lookbook__item {
    scroll-snap-align: start;
  }

  .lookbook__figure {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }

  .lookbook__media {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-media);
    background-color: var(--color-tile);
  }

  .lookbook__item:nth-child(even) .lookbook__media {
    aspect-ratio: 4 / 5;
  }

  .lookbook__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lookbook__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    padding-inline: 8px;
  }

  .lookbook__title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    text-transform: var(--font-heading-case);
    font-size: var(--font-h3-size);
  }

  @media screen and (min-width: 750px) {
    .lookbook__list {
      grid-auto-columns: minmax(42%, 1fr);
      align-items: start;
    }
  }

  @media screen and (min-width: 990px) {
    .lookbook__list {
      grid-auto-columns: minmax(32%, 1fr);
    }

    .lookbook__item:nth-child(even) {
      margin-top: 96px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.lookbook.name",
  "class": "section-lookbook",
  "max_blocks": 10,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.split_heading_info",
      "default": "Lookbook"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "t:sections.lookbook.blocks.look",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image_banner.image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:labels.heading",
          "default": "Look title"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:labels.link_label",
          "default": "Shop the look"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook.name",
      "blocks": [
        { "type": "look" },
        { "type": "look" },
        { "type": "look" },
        { "type": "look" }
      ]
    }
  ]
}
{% endschema %}
