{%- liquid
  assign style = section.settings.style
  assign scheme = section.settings.color_scheme.id
  assign filled = false
  if scheme != 'scheme-1'
    assign filled = true
  endif

  assign placeholder_title = 'sections.collection_list.placeholder_title' | t

  case style
    when 'numbered'
      assign image_sizes = '(min-width: 990px) 20vw, 45vw'
    when 'overlay'
      assign image_sizes = '(min-width: 750px) 50vw, 100vw'
    else
      assign image_sizes = '(min-width: 990px) 50vw, 100vw'
  endcase
-%}

<div class="section collection-list collection-list--{{ style }} color-{{ scheme }}{% if filled %} section--filled{% endif %}">
  <div class="collection-list__inner{% unless style == 'overlay' %} page-width{% endunless %}{% if style == 'mosaic' %} collection-list__inner--mosaic{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading{% if style == 'overlay' %} page-width{% endif %}">
        <h2 class="section-heading__title">{% render 'split-heading', text: section.settings.heading %}</h2>
        {%- if section.settings.link_label != blank -%}
          <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="collection-list__items{% if style == 'numbered' %} scroll-row{% endif %}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          if block.type == 'collection'
            assign item_collection = block.settings.collection
            assign item_url = item_collection.url
            assign item_title = block.settings.title | default: item_collection.title
            assign item_image = block.settings.image | default: item_collection.image | default: item_collection.featured_image
            assign item_count = item_collection.all_products_count
          else
            assign item_collection = blank
            assign item_url = block.settings.link
            assign item_title = block.settings.title
            assign item_image = block.settings.image
            assign item_count = blank
          endif
          assign number = forloop.index | prepend: '0' | slice: -2, 2
        -%}
        <li class="collection-list__item" {{ block.shopify_attributes }}>
          <a class="collection-tile" href="{{ item_url | default: routes.collections_url }}">
            <span class="collection-tile__media">
              {%- if item_image -%}
                {{
                  item_image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '400, 600, 800, 1200, 1600',
                    sizes: image_sizes,
                    loading: 'lazy',
                    alt: '',
                    class: 'collection-tile__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-tile__image placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="collection-tile__caption">
              {%- if style == 'numbered' -%}
                <span class="collection-tile__number">{{ number }}</span>
              {%- endif -%}
              <span class="collection-tile__title">
                {{- item_title | default: placeholder_title -}}
              </span>
              {%- if section.settings.show_count and item_count != blank and style != 'numbered' -%}
                <span class="collection-tile__count">{{ 'facets.product_count' | t: count: item_count }}</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .collection-list__items {
    margin: 0;
  }

  .collection-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    text-decoration: none;
  }

  .collection-tile:hover {
    color: inherit;
  }

  .collection-tile__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-media);
    background-color: var(--color-tile);
  }

  .collection-tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-medium) var(--ease);
  }

  @media (hover: hover) {
    .collection-tile:hover .collection-tile__image {
      transform: scale(1.03);
    }
  }

  .collection-list--numbered .scroll-row {
    --scroll-item-mobile: 43%;
    --scroll-item-min: 170px;
  }

  .collection-list--numbered .collection-tile__caption {
    padding-inline: 8px;
    font-size: var(--font-label-size);
    line-height: 16px;
    font-weight: var(--font-body-weight-medium);
    letter-spacing: var(--font-label-spacing);
    text-transform: uppercase;
  }

  .collection-tile__number {
    margin-inline-end: 8px;
    font-weight: var(--font-body-weight);
    color: var(--color-text-muted);
  }

  .collection-list--overlay .collection-list__items {
    display: grid;
    gap: var(--grid-gap);
  }

  .collection-list--overlay .collection-tile__media {
    aspect-ratio: 3 / 4;
    border-radius: 0;
  }

  .collection-list--overlay .collection-tile__caption,
  .collection-list--mosaic .collection-tile__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 40px 24px;
    color: #fff;
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }

  .collection-list--overlay .collection-tile__caption {
    align-items: center;
    text-align: center;
  }

  .collection-list--overlay .collection-tile__media::after,
  .collection-list--mosaic .collection-tile__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.4), transparent 45%);
  }

  .collection-list--overlay .collection-tile__title,
  .collection-list--mosaic .collection-tile__title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    text-transform: var(--font-heading-case);
    font-size: var(--font-h2-size);
    line-height: 1.1;
  }

  .collection-tile__count {
    font-size: var(--font-small-size);
  }

  .collection-list--overlay .collection-tile__count {
    font-size: var(--font-label-size);
    font-weight: var(--font-body-weight-medium);
    letter-spacing: var(--font-label-spacing);
    text-transform: uppercase;
  }

  .collection-list__inner--mosaic {
    max-width: none;
    padding-inline: 16px;
  }

  .collection-list--mosaic .section-heading {
    margin-inline: 16px;
  }

  .collection-list--mosaic .collection-list__items {
    display: grid;
    gap: 16px;
  }

  .collection-list--mosaic .collection-tile__media {
    aspect-ratio: auto;
    min-height: 312px;
    height: 100%;
  }

  .collection-list--mosaic .collection-tile__caption {
    align-items: flex-start;
    padding: 28px;
  }

  @media screen and (min-width: 750px) {
    .collection-list--overlay .collection-list__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .collection-list--mosaic .collection-list__items {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 312px;
    }

    .collection-list--mosaic .collection-list__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }

    .collection-list--mosaic .collection-list__item:nth-child(2) {
      grid-column: span 2;
    }

    .collection-list--mosaic .collection-list__item:first-child .collection-tile__caption {
      padding: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "class": "section-collection-list",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.collection_list.style",
      "options": [
        {
          "value": "numbered",
          "label": "t:sections.collection_list.style_numbered"
        },
        {
          "value": "overlay",
          "label": "t:sections.collection_list.style_overlay"
        },
        {
          "value": "mosaic",
          "label": "t:sections.collection_list.style_mosaic"
        }
      ],
      "default": "numbered"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.split_heading_info"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.main_collection.show_count",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.blocks.collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_list.blocks.collection"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.collection_list.blocks.title",
          "info": "t:sections.collection_list.blocks.title_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_list.blocks.image",
          "info": "t:sections.collection_list.blocks.image_info"
        }
      ]
    },
    {
      "type": "link",
      "name": "t:sections.collection_list.blocks.link",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.collection_list.blocks.title",
          "default": "Fit guide"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_list.blocks.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
