{%- liquid
  assign scheme = section.settings.color_scheme.id
  assign filled = false
  if scheme != 'scheme-1'
    assign filled = true
  endif
  assign featured = section.settings.collection
  assign link_url = section.settings.link | default: featured.url
  assign card_sizes = '(min-width: 990px) calc((100vw - 120px) / 4), (min-width: 750px) calc((100vw - 64px) / 3), 70vw'
-%}

<div class="section featured-collection color-{{ scheme }}{% if filled %} section--filled{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="section-heading">
        <h2 class="section-heading__title">
          {%- render 'split-heading', text: section.settings.heading -%}
          {%- if section.settings.show_count and featured != blank -%}
            <span class="section-heading__count">{{ 'facets.product_count' | t: count: featured.all_products_count }}</span>
          {%- endif -%}
        </h2>
        {%- if section.settings.link_label != blank and link_url != blank -%}
          <a class="text-link" href="{{ link_url }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="featured-collection__list{% if section.settings.layout == 'scroll' %} scroll-row{% else %} product-grid{% endif %}"
      role="list"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: 2;"
    >
      {%- if featured != blank and featured.products_count > 0 -%}
        {%- for product in featured.products limit: section.settings.products_to_show -%}
          <li>{% render 'product-card', product: product, sizes: card_sizes %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>
            <div class="featured-collection__placeholder">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <p class="text-small">{{ 'sections.featured_collection.placeholder' | t }}</p>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .featured-collection__placeholder {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    margin-bottom: 8px;
    border-radius: var(--radius-media);
  }

  .card--square .featured-collection .scroll-row,
  .card--framed .featured-collection .scroll-row {
    --scroll-item-min: 280px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.split_heading_info",
      "default": "New in"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.main_collection.show_count",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.layout",
      "options": [
        {
          "value": "scroll",
          "label": "t:sections.featured_collection.layout_scroll"
        },
        {
          "value": "grid",
          "label": "t:sections.featured_collection.layout_grid"
        }
      ],
      "default": "scroll",
      "info": "t:sections.featured_collection.layout_info"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.main_collection.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link",
      "info": "t:sections.featured_collection.link_info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
