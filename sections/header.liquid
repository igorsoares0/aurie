{%- liquid
  assign layout = settings.header_layout
  assign use_words = false
  if layout == 'center_text'
    assign use_words = true
  endif
  assign menu = section.settings.menu
-%}

<div class="header-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.show_divider %} header-wrapper--divider{% endif %}">
  <header class="header header--{{ layout }} page-width">
    <button
      class="button-unstyled header__menu-toggle{% if use_words %} label{% endif %}"
      type="button"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="MenuDrawer"
      data-menu-drawer-open
    >
      {%- if use_words -%}
        {{- 'header.menu' | t -}}
      {%- else -%}
        {% render 'icon', name: 'menu' %}
        <span class="visually-hidden">{{ 'header.menu' | t }}</span>
      {%- endif -%}
    </button>

    {%- if layout == 'center_icons' -%}
      <div class="header__tools header__tools--start">
        {% render 'header-search-link', use_words: use_words %}
        {%- if section.settings.store_link != blank -%}
          <a class="header__tool" href="{{ section.settings.store_link }}">
            {% render 'icon', name: 'pin' %}
            <span class="visually-hidden">{{ 'header.find_a_store' | t }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo -%}
        {%- liquid
          assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round
          assign logo_width_2x = section.settings.logo_width | times: 2
          assign logo_widths = section.settings.logo_width | append: ', ' | append: logo_width_2x
        -%}
        {{
          section.settings.logo
          | image_url: width: logo_width_2x
          | image_tag:
            width: section.settings.logo_width,
            height: logo_height,
            widths: logo_widths,
            alt: shop.name,
            class: 'header__logo-image',
            preload: true
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if menu.links.size > 0 -%}
      <nav class="header__nav" aria-label="{{ 'header.main_menu' | t }}">
        <ul class="header__menu label" role="list">
          {%- for link in menu.links -%}
            <li class="header__menu-item">
              {%- if link.links.size > 0 -%}
                <details class="header__dropdown">
                  <summary class="header__menu-link{% if link.child_active or link.active %} header__menu-link--active{% endif %}">
                    {{- link.title -}}
                    {% render 'icon', name: 'caret' %}
                  </summary>
                  {%- liquid
                    assign link_key = link.title | downcase | strip
                    capture promotions
                      for block in section.blocks
                        assign item_key = block.settings.menu_item | downcase | strip
                        if item_key == link_key
                          render 'header-promotion', block: block
                        endif
                      endfor
                    endcapture
                  -%}
                  <div class="header__panel color-{{ section.settings.color_scheme }}">
                    <div class="header__panel-inner page-width">
                    <ul class="header__panel-list" role="list">
                      {%- for child in link.links -%}
                        <li class="header__panel-column">
                          <a
                            class="header__panel-link{% if child.links.size > 0 %} label{% endif %}"
                            href="{{ child.url }}"
                            {% if child.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- child.title -}}
                          </a>
                          {%- if child.links.size > 0 -%}
                            <ul class="header__panel-sublist" role="list">
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a
                                    class="header__panel-link"
                                    href="{{ grandchild.url }}"
                                    {% if grandchild.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{- grandchild.title -}}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                    {%- if promotions != blank -%}
                      <div class="header__promotions">{{ promotions }}</div>
                    {%- endif -%}
                    </div>
                  </div>
                </details>
              {%- else -%}
                <a
                  class="header__menu-link{% if link.active %} header__menu-link--active{% endif %}"
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title -}}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="header__tools header__tools--end{% if use_words %} label{% endif %}">
      {% render 'header-search-link', use_words: use_words %}

      {%- if shop.customer_accounts_enabled -%}
        <shopify-account class="header__tool header__account" menu="{{ section.settings.customer_account_menu.handle | default: 'customer-account-main-menu' }}">
          {%- if use_words -%}
            <span class="header__account-label label" slot="signed-out-avatar">{{ 'header.account' | t }}</span>
          {%- else -%}
            <span class="header__account-label" slot="signed-out-avatar">
              {%- render 'icon', name: 'account' -%}
              <span class="visually-hidden">{{ 'header.account' | t }}</span>
            </span>
          {%- endif -%}
        </shopify-account>
      {%- endif -%}

      {%- assign cart_count_html = '<span data-cart-count>' | append: cart.item_count | append: '</span>' -%}
      <a
        class="header__tool header__cart"
        href="{{ routes.cart_url }}"
        id="HeaderCartLink"
        {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
          data-dialog-open="CartDrawer"
          aria-haspopup="dialog"
        {% endif %}
      >
        {%- if use_words -%}
          {%- comment -%} One element, so the flex gap doesn't split "Bag (0)" into pieces that can wrap {%- endcomment -%}
          <span class="header__cart-label">{{- 'header.bag_count_html' | t: count: cart_count_html -}}</span>
        {%- else -%}
          {% render 'icon', name: 'bag' %}
          <span aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'header.bag_count_html' | t: count: cart_count_html }}</span>
        {%- endif -%}
      </a>
    </div>
  </header>

  <dialog
    class="menu-drawer color-{{ section.settings.color_scheme }}"
    id="MenuDrawer"
    aria-label="{{ 'header.menu' | t }}"
    scroll-lock
  >
    <div class="menu-drawer__header">
      <span class="header__logo-text">{{ shop.name }}</span>
      <button class="button-unstyled" type="button" data-menu-drawer-close>
        {% render 'icon', name: 'close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
    </div>

    {%- if menu.links.size > 0 -%}
      <nav class="menu-drawer__nav" aria-label="{{ 'header.main_menu' | t }}">
        <ul class="menu-drawer__list" role="list">
          {%- for link in menu.links -%}
            <li>
              {%- if link.links.size > 0 -%}
                <details class="menu-drawer__details">
                  <summary class="menu-drawer__link h3">
                    {%- if section.settings.drawer_images -%}
                    {%- assign drawer_image = nil -%}
                    {%- if link.type == 'collection_link' -%}
                      {%- assign drawer_image = link.object.image | default: link.object.featured_image -%}
                    {%- endif -%}
                    <span class="menu-drawer__thumb">
                      {%- if drawer_image != blank -%}
                        {{ drawer_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '80px', alt: '' }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                    <span class="menu-drawer__label">{{- link.title -}}</span>
                    {% render 'icon', name: 'caret' %}
                  </summary>
                  <ul class="menu-drawer__sublist" role="list">
                    {%- for child in link.links -%}
                      <li>
                        <a class="menu-drawer__sublink" href="{{ child.url }}">{{ child.title }}</a>
                        {%- if child.links.size > 0 -%}
                          <ul class="menu-drawer__sublist menu-drawer__sublist--nested" role="list">
                            {%- for grandchild in child.links -%}
                              <li>
                                <a class="menu-drawer__sublink text-muted" href="{{ grandchild.url }}">
                                  {{- grandchild.title -}}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a
                  class="menu-drawer__link h3"
                  href="{{ link.url }}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {%- if section.settings.drawer_images -%}
                    {%- assign drawer_image = nil -%}
                    {%- if link.type == 'collection_link' -%}
                      {%- assign drawer_image = link.object.image | default: link.object.featured_image -%}
                    {%- endif -%}
                    <span class="menu-drawer__thumb">
                      {%- if drawer_image != blank -%}
                        {{ drawer_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '80px', alt: '' }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  <span class="menu-drawer__label">{{- link.title -}}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="menu-drawer__footer">
      <a class="menu-drawer__sublink" href="{{ routes.search_url }}" data-dialog-open="SearchModal" aria-haspopup="dialog">{{ 'header.search' | t }}</a>
      {%- if section.settings.store_link != blank -%}
        <a class="menu-drawer__sublink" href="{{ section.settings.store_link }}">{{ 'header.find_a_store' | t }}</a>
      {%- endif -%}
      {% render 'localization-form',
        id: 'drawer',
        show_country: section.settings.show_country_selector,
        show_language: section.settings.show_language_selector
      %}
    </div>
  </dialog>

  {% render 'search-modal', color_scheme: section.settings.color_scheme %}
</div>

{% stylesheet %}
  .header-wrapper {
    position: relative;
    z-index: 10;
  }

  .header-wrapper--divider {
    border-bottom: 1px solid var(--color-divider);
  }

  .header {
    display: grid;
    /* The logo track may shrink so a long store name never pushes the icons off screen */
    grid-template-columns: 1fr minmax(0, auto) 1fr;
    grid-template-areas: 'toggle logo end';
    align-items: center;
    column-gap: 16px;
    min-height: 56px;
    padding-block: 6px;
  }

  .header__menu-toggle {
    grid-area: toggle;
    justify-self: start;
    padding-inline: 8px;
    margin-inline-start: -8px;
  }

  .header__logo {
    grid-area: logo;
    display: block;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .header__logo:hover {
    color: inherit;
  }

  .header__logo-image {
    max-width: 100%;
    height: auto;
  }

  .header__logo-text {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: calc(1.625rem * var(--font-heading-scale));
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: var(--font-heading-case);
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* Room for descenders, which overflow: hidden would clip at line-height 1 */
    padding-block: 0.15em;
    margin-block: -0.15em;
  }

  .header--center_text .header__logo-text {
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .header__nav {
    display: none;
  }

  .header__tools {
    display: flex;
    align-items: center;
  }

  .header__tools--start {
    display: none;
  }

  .header__tools--end {
    grid-area: end;
    justify-self: end;
    gap: 0;
  }

  .header__tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    padding-inline: 8px;
    text-decoration: none;
    color: inherit;
  }

  .header__tools--end.label .header__tool {
    min-width: 0;
  }

  .header__search-link {
    display: none;
  }

  .header--center_icons .header__tools--end .header__search-link,
  .header--left .header__tools--end .header__search-link {
    display: inline-flex;
  }

  .header--center_text .header__account::part(signed-out-avatar) {
    width: auto;
    min-width: 0;
    height: auto;
    padding: 0;
  }

  .header__account {
    --shopify-account-font-body: var(--font-body-family);
    --shopify-account-font-heading: var(--font-heading-family);
    --shopify-account-radius-button: var(--radius-button);
    --shopify-account-radius-input: var(--radius-input);
    --shopify-account-radius-dialog: var(--radius-media);
    --shopify-account-color-text: var(--color-text);
    --shopify-account-color-background: var(--color-background);
    --shopify-account-color-accent: var(--color-button);
  }

  .header__account-label {
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
  }

  .header__cart {
    font-size: var(--font-caption-size);
  }

  .header__cart-label {
    white-space: nowrap;
  }

  .header__menu {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
  }

  .header__menu-link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding-block: 4px;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .header__menu-link::-webkit-details-marker {
    display: none;
  }

  .header__menu-link .icon {
    width: 14px;
    height: 14px;
    transition: transform var(--duration-short) var(--ease);
  }

  .header__dropdown[open] .header__menu-link .icon {
    transform: rotate(180deg);
  }

  .header__menu-link--active,
  .header__menu-link[aria-current='page'],
  .header__menu-link:hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .header__panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    padding-block: 32px 40px;
    border-top: 1px solid var(--color-divider);
    border-bottom: 1px solid var(--color-divider);
    text-transform: none;
    letter-spacing: normal;
    font-weight: var(--font-body-weight);
  }

  .header__panel-inner {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }

  .header__panel-list {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 24px 48px;
    margin: 0;
    padding-block: 0;
  }

  .header__promotions {
    display: flex;
    flex-shrink: 0;
    gap: var(--grid-gap);
  }

  .header__panel-column {
    min-width: 160px;
  }

  .header__panel-link {
    display: inline-block;
    padding-block: 4px;
    font-size: var(--font-small-size);
    text-decoration: none;
  }

  .header__panel-link.label {
    font-size: var(--font-label-size);
    margin-block-end: 8px;
  }

  .header__panel-link:hover,
  .header__panel-link[aria-current='page'] {
    color: inherit;
    text-decoration: underline;
  }

  .header__panel-sublist {
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .header__menu-toggle {
      display: none;
    }

    .header__nav {
      display: block;
    }

    .header__search-link {
      display: inline-flex;
    }

    .header--center_icons .header__tools--end .header__search-link {
      display: none;
    }

    .header--center_text {
      grid-template-areas: 'nav logo end';
      padding-block: 16px;
    }

    .header--center_text .header__nav {
      grid-area: nav;
    }

    .header--center_text .header__menu {
      gap: 8px 24px;
    }

    .header--center_text .header__tools--end {
      gap: 8px 24px;
    }

    .header--center_text .header__tool {
      padding-inline: 0;
    }

    .header--center_icons {
      grid-template-areas:
        'start logo end'
        'nav nav nav';
      padding-block: 12px 0;
    }

    .header--center_icons .header__tools--start {
      grid-area: start;
      display: flex;
      gap: 4px;
    }

    .header--center_icons .header__logo-text {
      font-size: calc(2.125rem * var(--font-heading-scale));
      letter-spacing: 0.02em;
    }

    .header--center_icons .header__nav {
      grid-area: nav;
      margin-top: 8px;
      border-bottom: 1px solid var(--color-divider);
    }

    .header--center_icons .header__menu {
      justify-content: center;
      gap: 4px 40px;
      padding-block: 12px;
    }

    .header--left {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'logo nav end';
      column-gap: 32px;
      padding-block: 16px;
    }

    .header--left .header__logo-text {
      font-size: calc(2rem * var(--font-heading-scale));
    }

    .header--left .header__nav {
      grid-area: nav;
      justify-self: center;
    }

    .header--left .header__menu {
      gap: 4px 28px;
    }

    .header--left .header__menu-link {
      padding-block: 6px;
    }
  }

  .menu-drawer {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
  }

  .menu-drawer::backdrop {
    background: transparent;
  }

  .menu-drawer[open] {
    display: flex;
    flex-direction: column;
  }

  .menu-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 6px var(--page-margin);
    border-bottom: 1px solid var(--color-divider);
  }

  .menu-drawer__nav {
    padding: 16px var(--page-margin) 32px;
  }

  .menu-drawer__list {
    margin: 0;
  }

  .menu-drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--touch-target);
    padding-block: 8px;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .menu-drawer__link::-webkit-details-marker {
    display: none;
  }

  .menu-drawer__thumb {
    flex: none;
    width: 80px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: calc(var(--radius-media) / 2);
    background-color: var(--color-tile);
  }

  .menu-drawer__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-drawer__label {
    flex: 1;
  }

  .menu-drawer__link:has(.menu-drawer__thumb) {
    justify-content: flex-start;
    gap: 16px;
  }

  .menu-drawer__details[open] > .menu-drawer__link .icon {
    transform: rotate(180deg);
  }

  .menu-drawer__sublist {
    margin: 0 0 16px;
  }

  .menu-drawer__sublist--nested {
    margin: 0 0 8px 16px;
  }

  .menu-drawer__sublink {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
    text-decoration: none;
  }

  .menu-drawer__footer {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: auto;
    padding: 24px var(--page-margin) 32px;
    border-top: 1px solid var(--color-divider);
  }

  @media screen and (min-width: 990px) {
    .menu-drawer {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    document.querySelectorAll('.header__dropdown[open]').forEach((dropdown) => {
      if (!dropdown.contains(event.target)) dropdown.removeAttribute('open');
    });

    const opener = event.target.closest('[data-menu-drawer-open]');
    if (opener) {
      const drawer = document.getElementById(opener.getAttribute('aria-controls'));
      drawer?.showModal();
      opener.setAttribute('aria-expanded', 'true');
      return;
    }

    const closer = event.target.closest('[data-menu-drawer-close]');
    if (closer) closer.closest('dialog')?.close();
  });

  document.addEventListener('toggle', (event) => {
    const dropdown = event.target;
    if (!dropdown.matches?.('.header__dropdown') || !dropdown.open) return;
    document.querySelectorAll('.header__dropdown[open]').forEach((other) => {
      if (other !== dropdown) other.removeAttribute('open');
    });
  }, true);

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const dropdown = document.querySelector('.header__dropdown[open]');
    if (!dropdown) return;
    dropdown.removeAttribute('open');
    dropdown.querySelector('summary')?.focus();
  });

  document.addEventListener('close', (event) => {
    if (event.target.id !== 'MenuDrawer') return;
    const opener = document.querySelector('[data-menu-drawer-open][aria-expanded="true"]');
    opener?.setAttribute('aria-expanded', 'false');
    opener?.focus();
  }, true);
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.header.show_divider",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.header.logo_header"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.logo",
      "info": "t:sections.header.logo_info"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.header.logo_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "t:sections.header.navigation_header"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:sections.header.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "url",
      "id": "store_link",
      "label": "t:sections.header.store_link",
      "info": "t:sections.header.store_link_info"
    },
    {
      "type": "header",
      "content": "t:sections.header.localization_header"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
