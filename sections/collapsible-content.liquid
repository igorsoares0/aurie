{%- liquid
  assign scheme = section.settings.color_scheme.id
  assign filled = false
  if scheme != 'scheme-1'
    assign filled = true
  endif
-%}

<div class="section collapsible-content color-{{ scheme }}{% if filled %} section--filled{% endif %}">
  <div class="collapsible-content__inner page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="collapsible-content__intro">
        {%- if section.settings.heading != blank -%}
          <h2>{% render 'split-heading', text: section.settings.heading %}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collapsible-content__rows">
      {%- for block in section.blocks -%}
        <details class="collapsible-row" {% if section.settings.open_first and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="collapsible-row__summary">
            <span>{{ block.settings.heading }}</span>
            <span class="collapsible-row__icon" aria-hidden="true">
              {%- render 'icon', name: 'plus', class: 'collapsible-row__plus' -%}
              {%- render 'icon', name: 'minus', class: 'collapsible-row__minus' -%}
            </span>
          </summary>
          <div class="collapsible-row__content rte">
            {{ block.settings.content }}
            {{ block.settings.page.content }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .collapsible-content__inner {
    display: grid;
    gap: 32px;
  }

  .collapsible-content__intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 32rem;
  }

  .collapsible-content__rows {
    border-top: 1px solid var(--color-divider);
  }

  .collapsible-row {
    border-bottom: 1px solid var(--color-divider);
  }

  .collapsible-row__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    font-size: calc(var(--font-body-size) + 1px);
    cursor: pointer;
    list-style: none;
  }

  .collapsible-row__summary::-webkit-details-marker {
    display: none;
  }

  .collapsible-row__icon .icon {
    width: 16px;
    height: 16px;
  }

  .collapsible-row__minus,
  .collapsible-row[open] .collapsible-row__plus {
    display: none;
  }

  .collapsible-row[open] .collapsible-row__minus {
    display: block;
  }

  .collapsible-row__content {
    padding-bottom: 20px;
  }

  @media screen and (min-width: 990px) {
    .collapsible-content__inner:has(.collapsible-content__intro) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 64px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collapsible_content.name",
  "class": "section-collapsible-content",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.split_heading_info",
      "default": "Questions and answers"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:sections.collapsible_content.open_first",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.collapsible_content.blocks.row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:blocks.collapsible_tab.content",
          "default": "<p>Share the answer, details about a policy or anything else customers ask.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:blocks.collapsible_tab.page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collapsible_content.name",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
