<div class="main-list-collections color-{{ section.settings.color_scheme }}">
  <div class="main-list-collections__inner page-width">
    {%- assign default_heading = 'collections.title' | t -%}
    <h1>{{ section.settings.heading | default: default_heading }}</h1>

    {%- paginate collections by section.settings.per_page -%}
      <ul class="main-list-collections__grid" role="list">
        {%- for collection in collections -%}
          <li>
            <a class="collection-card" href="{{ collection.url }}">
              <span class="collection-card__media">
                {%- assign card_image = collection.featured_image -%}
                {%- if card_image -%}
                  {{
                    card_image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      loading: 'lazy',
                      alt: '',
                      class: 'collection-card__image'
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'collection-card__image' }}
                {%- endif -%}
              </span>
              <span class="collection-card__row">
                <span class="index-no">
                  {%- assign collection_number = paginate.current_offset | plus: forloop.index -%}
                  {%- if collection_number < 10 -%}0{%- endif -%}
                  {{- collection_number -}}
                </span>
                <span class="collection-card__title h3">{{ collection.title }}</span>
              </span>
              <span class="figure-caption">{{ 'facets.product_count' | t: count: collection.all_products_count }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

{%- for block in section.blocks -%}
  {%- if block.type == '@app' -%}
    <div class="app-block page-width">{% render block %}</div>
  {%- elsif block.type == 'custom_liquid' -%}
    <div class="app-block page-width" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
  {%- endif -%}
{%- endfor -%}

{% stylesheet %}
  .collection-card__row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .main-list-collections .collection-card__media {
    border: 1px solid var(--color-divider);
  }

  .main-list-collections__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 48px var(--section-spacing);
  }

  /* Collections as rows of the index, so any number of them lines up */
  .main-list-collections__grid {
    display: flex;
    flex-direction: column;
    margin: 0;
    border-top: var(--rule-strong);
  }

  .main-list-collections__grid > li {
    border-bottom: var(--rule-thin);
  }

  .collection-card {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    align-items: start;
    gap: 4px 16px;
    padding-block: 14px;
    text-decoration: none;
  }

  .collection-card__media {
    grid-row: 1 / span 2;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-media);
    background-color: var(--color-tile);
  }

  @media screen and (min-width: 750px) {
    .collection-card {
      grid-template-columns: 200px minmax(0, 1fr) auto;
      grid-template-rows: auto;
      align-items: center;
      gap: 0 32px;
    }

    .collection-card__media {
      grid-row: auto;
    }
  }

  .collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-medium) var(--ease);
  }

  @media (hover: hover) {
    .collection-card:hover .collection-card__image {
      transform: scale(1.03);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "class": "section-main-list-collections",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:sections.main_list_collections.per_page",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom_liquid",
      "name": "t:blocks.custom_liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:blocks.custom_liquid.label",
          "info": "t:blocks.custom_liquid.info"
        }
      ]
    }
  ]
}
{% endschema %}
