<div class="main-password color-{{ section.settings.color_scheme }}">
  <div class="main-password__inner page-width">
    <div class="main-password__brand">
      {%- if shop.brand.logo -%}
        {{
          shop.brand.logo
          | image_url: width: 400
          | image_tag: widths: '200, 400', sizes: '200px', alt: shop.name, class: 'main-password__logo'
        }}
      {%- else -%}
        <p class="main-password__store h2">{{ shop.name }}</p>
      {%- endif -%}
    </div>

    <h1 class="main-password__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="main-password__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', id: 'PasswordNewsletter', class: 'main-password__newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, password page">
        {%- if form.posted_successfully? -%}
          <p class="main-password__success text-small" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="main-password__errors text-small" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <label class="label" for="PasswordNewsletterEmail">{{ 'password.newsletter_label' | t }}</label>
          <div class="main-password__row">
            <input class="field" id="PasswordNewsletterEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email_placeholder' | t }}">
            <button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <details class="main-password__owner">
      <summary class="main-password__owner-toggle text-small">{{ 'password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password', class: 'main-password__form' -%}
        {%- if form.errors -%}
          <div class="main-password__errors text-small" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label class="label" for="PasswordInput">{{ 'password.password' | t }}</label>
        <div class="main-password__row">
          <input class="field" type="password" name="password" id="PasswordInput" autocomplete="current-password" required>
          <button class="button button--secondary" type="submit">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% stylesheet %}
  .main-password {
    flex: 1;
    display: flex;
  }

  .main-password__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    min-height: 100svh;
    padding-block: 64px;
    text-align: center;
  }

  .main-password__logo {
    width: 200px;
    height: auto;
  }

  .main-password__store {
    letter-spacing: 0.08em;
  }

  .main-password__message {
    max-width: 32rem;
  }

  .main-password__newsletter,
  .main-password__form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(100%, 440px);
    text-align: start;
  }

  .main-password__row {
    display: flex;
    gap: 8px;
  }

  .main-password__owner {
    width: min(100%, 440px);
  }

  .main-password__owner-toggle {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .main-password__success {
    color: var(--color-success);
  }

  .main-password__errors {
    color: var(--color-error);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "section-main-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Opening soon"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main_password.show_newsletter",
      "default": true
    }
  ]
}
{% endschema %}
