{%- assign scheme = section.settings.color_scheme.id -%}

<slide-show
  class="section slideshow slideshow--{{ section.settings.height }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed | times: 1000 }}"
>
  <div class="slideshow__track color-{{ scheme }}" tabindex="0">
    {%- for block in section.blocks -%}
      <div
        class="slideshow__slide"
        id="Slide-{{ block.id }}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ 'sections.testimonials.slide' | t: number: forloop.index, total: forloop.length }}"
        {{ block.shopify_attributes }}
      >
        <div class="slideshow__media">
          {%- if block.settings.image -%}
            {%- liquid
              if section.index <= 2 and forloop.first
                assign loading = 'eager'
              else
                assign loading = 'lazy'
              endif
            -%}
            {{
              block.settings.image
              | image_url: width: 3200
              | image_tag:
                widths: '750, 1100, 1500, 2000, 2600, 3200',
                sizes: '100vw',
                loading: loading,
                alt: block.settings.image.alt,
                class: 'slideshow__image'
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'slideshow__image placeholder-svg' }}
          {%- endif -%}
          <span class="slideshow__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></span>
        </div>
        <div class="slideshow__content page-width">
          {%- if block.settings.heading != blank -%}
            {%- if section.index == 1 and forloop.first -%}
              <h1 class="display slideshow__heading">{{ block.settings.heading }}</h1>
            {%- else -%}
              <h2 class="display slideshow__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="slideshow__text">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a class="button" href="{{ block.settings.link }}">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="slideshow__controls page-width">
      <button class="slideshow__button" type="button" data-step="-1">
        {% render 'icon', name: 'arrow-left' %}
        <span class="visually-hidden">{{ 'sections.slideshow.previous' | t }}</span>
      </button>
      <span class="slideshow__position text-caption" aria-live="polite"><span data-current>1</span> / {{ section.blocks.size }}</span>
      <button class="slideshow__button" type="button" data-step="1">
        {% render 'icon', name: 'arrow' %}
        <span class="visually-hidden">{{ 'sections.slideshow.next' | t }}</span>
      </button>
      {%- if section.settings.autoplay -%}
        <button class="slideshow__button slideshow__pause" type="button" aria-pressed="false" data-pause>
          <span class="slideshow__pause-icon" aria-hidden="true"></span>
          <span class="visually-hidden">{{ 'sections.slideshow.pause' | t }}</span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</slide-show>

{% stylesheet %}
  slide-show {
    position: relative;
    display: block;
  }

  .slideshow--medium {
    --slide-height: 520px;
  }

  .slideshow--large {
    --slide-height: 720px;
  }

  .slideshow--screen {
    --slide-height: 100svh;
  }

  .slideshow__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .slideshow__track::-webkit-scrollbar {
    display: none;
  }

  .slideshow__slide {
    position: relative;
    display: flex;
    align-items: flex-end;
    flex: 0 0 100%;
    min-height: var(--slide-height);
    scroll-snap-align: start;
  }

  .slideshow__media {
    position: absolute;
    inset: 0;
  }

  .slideshow__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slideshow__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-background);
    opacity: var(--overlay-opacity);
  }

  .slideshow__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-block: 48px 96px;
  }

  .slideshow__text {
    max-width: 420px;
  }

  .slideshow__controls {
    position: absolute;
    inset-inline: 0;
    bottom: 24px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }

  .slideshow__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0;
    border: 0;
    border-radius: var(--radius-button);
    background-color: var(--color-background);
    color: var(--color-text);
    cursor: pointer;
    pointer-events: auto;
  }

  .slideshow__button .icon {
    width: 18px;
    height: 18px;
  }

  .slideshow__position {
    padding: 4px 10px;
    border-radius: var(--radius-button);
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .slideshow__pause-icon {
    width: 10px;
    height: 12px;
    border-inline: 3px solid currentcolor;
  }

  .slideshow__pause[aria-pressed='true'] .slideshow__pause-icon {
    width: 0;
    height: 0;
    border-block: 6px solid transparent;
    border-inline: 10px solid currentcolor;
    border-inline-end: 0;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('slide-show')) {
    customElements.define(
      'slide-show',
      class SlideShow extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('.slideshow__track');
          this.slides = [...this.querySelectorAll('.slideshow__slide')];
          this.index = 0;

          this.querySelectorAll('[data-step]').forEach((button) => {
            button.addEventListener('click', () => {
              this.goTo(this.index + Number(button.dataset.step));
              this.stop();
            });
          });

          this.track.addEventListener('scroll', () => {
            const index = Math.round(this.track.scrollLeft / this.track.clientWidth);
            if (index !== this.index) this.setIndex(index);
          }, { passive: true });

          this.pauseButton = this.querySelector('[data-pause]');
          this.pauseButton?.addEventListener('click', () => {
            if (this.timer) {
              this.stop();
            } else {
              this.play();
            }
          });

          this.addEventListener('focusin', () => this.stop());
          this.addEventListener('shopify:block:select', (event) => {
            this.stop();
            const index = this.slides.findIndex((slide) => slide.contains(event.target));
            if (index >= 0) this.goTo(index);
          });

          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (this.dataset.autoplay === 'true' && !reduceMotion && this.slides.length > 1) this.play();
        }

        disconnectedCallback() {
          this.stop();
        }

        setIndex(index) {
          this.index = index;
          const current = this.querySelector('[data-current]');
          if (current) current.textContent = index + 1;
        }

        goTo(index) {
          const count = this.slides.length;
          const next = (index + count) % count;
          this.track.scrollTo({ left: this.slides[next].offsetLeft, behavior: window.Theme.scrollBehavior() });
          this.setIndex(next);
        }

        play() {
          this.stop();
          this.timer = setInterval(() => this.goTo(this.index + 1), Number(this.dataset.speed) || 5000);
          this.pauseButton?.setAttribute('aria-pressed', 'false');
        }

        stop() {
          clearInterval(this.timer);
          this.timer = null;
          this.pauseButton?.setAttribute('aria-pressed', 'true');
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "class": "section-slideshow",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "info": "t:sections.image_banner.color_scheme_info",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.image_banner.height",
      "options": [
        { "value": "medium", "label": "t:sections.image_banner.height_medium" },
        { "value": "large", "label": "t:sections.image_banner.height_large" },
        { "value": "screen", "label": "t:sections.image_banner.height_screen" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.image_banner.overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow.autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:sections.slideshow.speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "t:sections.slideshow.accessibility_label",
      "default": "Slideshow"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image_banner.image"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Slide"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.name",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
