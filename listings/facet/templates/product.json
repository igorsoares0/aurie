{
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {
        "color_scheme": "scheme-1",
        "media_ratio": "auto",
        "show_breadcrumb": true,
        "sticky_info": true
      },
      "blocks": {
        "title": {
          "type": "title",
          "settings": {
            "eyebrow": "type"
          }
        },
        "spec": {
          "type": "text",
          "settings": {
            "text": "<p>Add the material and size, or connect a product metafield.</p>",
            "style": "caption"
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "show_tax_note": true
          }
        },
        "installments": {
          "type": "installments",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant-picker",
          "settings": {
            "style": "buttons",
            "show_swatches": true,
            "swatch_style": "labeled",
            "size_guide_options": "Ring size, Size",
            "size_guide_label": "Ring size guide"
          }
        },
        "engraving": {
          "type": "engraving-field",
          "settings": {
            "toggle_label": "Add engraving",
            "toggle_note": "Free, inside the band",
            "field_label": "Your text",
            "placeholder": "e.g. A · 2026",
            "max_characters": 12,
            "helper": "Engraved pieces ship in 5 days.",
            "property_name": "Engraving"
          }
        },
        "buy_buttons": {
          "type": "buy-buttons",
          "settings": {
            "show_quantity": true,
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "pickup": {
          "type": "pickup-availability",
          "settings": {}
        },
        "gift_box": {
          "type": "lead-time",
          "settings": {
            "icon": "gift",
            "text": "<p>Arrives in our gift box with a card.</p>"
          }
        },
        "tab_details": {
          "type": "collapsible-tab",
          "settings": {
            "heading": "Details",
            "heading_style": "heading",
            "open": false,
            "show_description": true
          }
        },
        "tab_materials": {
          "type": "collapsible-tab",
          "settings": {
            "heading": "Materials and care",
            "heading_style": "heading",
            "open": false,
            "show_description": false,
            "content": "<p>Share the metal, finish and how to care for the piece.</p>"
          }
        },
        "tab_shipping": {
          "type": "collapsible-tab",
          "settings": {
            "heading": "Shipping and returns",
            "heading_style": "heading",
            "open": false,
            "show_description": false,
            "content": "<p>Share delivery times and your return policy.</p>"
          }
        }
      },
      "block_order": [
        "title",
        "spec",
        "price",
        "installments",
        "variant_picker",
        "engraving",
        "buy_buttons",
        "pickup",
        "gift_box",
        "tab_details",
        "tab_materials",
        "tab_shipping"
      ]
    },
    "complementary": {
      "type": "product-recommendations",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "Pairs <em>well with</em>",
        "intent": "complementary",
        "products_to_show": 3
      }
    },
    "related": {
      "type": "product-recommendations",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "You may <em>also like</em>",
        "intent": "related",
        "products_to_show": 4
      }
    }
  },
  "order": [
    "main",
    "complementary",
    "related"
  ]
}
