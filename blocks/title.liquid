{%- liquid
  assign product = closest.product
  case block.settings.eyebrow
    when 'type'
      assign eyebrow = product.type
    when 'vendor'
      assign eyebrow = product.vendor
    else
      assign eyebrow = blank
  endcase

  assign catalog_number = blank
  if block.settings.show_catalog_number and settings.catalog_number_metafield != blank
    assign catalog_key = settings.catalog_number_metafield | split: '.'
    assign catalog_number = product.metafields[catalog_key.first][catalog_key.last].value
  endif
-%}

<div class="product-title" {{ block.shopify_attributes }}>
  {%- if eyebrow != blank or catalog_number != blank -%}
    <p class="label text-muted">
      {%- if catalog_number != blank -%}
        <span class="index-no">{{ 'product.catalog_number' | t: number: catalog_number }}</span>
        {%- if eyebrow != blank %} · {% endif -%}
      {%- endif -%}
      {{- eyebrow -}}
    </p>
  {%- endif -%}
  <h1 class="product-title__heading">
    {%- assign title_words = product.title | split: ' ' -%}
    {%- if settings.heading_italic_accent and title_words.size > 1 -%}
      {%- assign last_word = title_words | last -%}
      {{- product.title | remove_last: last_word | strip }} <span class="italic-accent">{{ last_word }}</span>
    {%- else -%}
      {{- product.title -}}
    {%- endif -%}
  </h1>
</div>

{% stylesheet %}
  .product-title {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.title.name",
  "settings": [
    {
      "type": "select",
      "id": "eyebrow",
      "label": "t:blocks.title.eyebrow",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.title.eyebrow_none"
        },
        {
          "value": "type",
          "label": "t:blocks.title.eyebrow_type"
        },
        {
          "value": "vendor",
          "label": "t:blocks.title.eyebrow_vendor"
        }
      ],
      "default": "type"
    },
    {
      "type": "checkbox",
      "id": "show_catalog_number",
      "label": "t:blocks.title.show_catalog_number",
      "info": "t:blocks.title.show_catalog_number_info",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:blocks.title.name"
    }
  ]
}
{% endschema %}
