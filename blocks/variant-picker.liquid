{%- liquid
  assign product = closest.product
  assign size_guide_page = block.settings.size_guide_page
  assign size_guide_options = block.settings.size_guide_options | downcase | split: ','
  assign size_guide_dialog_id = 'SizeGuide-' | append: block.id
  assign has_size_guide = false
-%}

{%- unless product.has_only_default_variant -%}
  <div
    class="variant-picker variant-picker--{{ block.settings.style }}"
    data-variant-picker
    data-product-part="picker-{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_id = 'Option-' | append: block.id | append: '-' | append: option.position
        assign option_name_key = option.name | downcase | strip

        assign show_size_guide = false
        if size_guide_page != blank
          for guide_option in size_guide_options
            assign guide_option_key = guide_option | strip
            if guide_option_key == option_name_key
              assign show_size_guide = true
              assign has_size_guide = true
            endif
          endfor
        endif

        assign has_swatches = false
        if block.settings.show_swatches and option.values.first.swatch
          assign has_swatches = true
        endif
      -%}

      {%- capture size_guide_link -%}
        {%- if show_size_guide -%}
          <button class="variant-picker__guide" type="button" data-dialog-open="{{ size_guide_dialog_id }}" aria-haspopup="dialog">
            {{- block.settings.size_guide_label | default: size_guide_page.title -}}
          </button>
        {%- endif -%}
      {%- endcapture -%}

      {%- if block.settings.style == 'dropdown' and has_swatches == false -%}
        <div class="variant-picker__option">
          <div class="variant-picker__head">
            <label class="variant-picker__label" for="{{ option_id }}">{{ option.name }}</label>
            {{ size_guide_link }}
          </div>
          <select class="field" id="{{ option_id }}" name="options[{{ option.name | escape }}]" data-option>
            {%- for value in option.values -%}
              <option
                value="{{ value | escape }}"
                data-option-value-id="{{ value.id }}"
                {% if value.selected %}
                  selected
                {% endif %}
              >
                {{- value -}}
                {%- unless value.available %} – {{ 'product.price.sold_out' | t }}{% endunless -%}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- else -%}
        <fieldset class="variant-picker__option variant-picker__option--fieldset" data-option>
          <legend class="variant-picker__label">
            {{- option.name }} — <span class="variant-picker__selected">{{ option.selected_value }}</span>
          </legend>
          {{ size_guide_link }}

          <div class="variant-picker__values{% if has_swatches %} variant-picker__values--swatches variant-picker__values--{{ block.settings.swatch_style }}{% endif %}">
            {%- for value in option.values -%}
              {%- assign value_id = option_id | append: '-' | append: forloop.index -%}
              <input
                class="variant-picker__input visually-hidden"
                type="radio"
                id="{{ value_id }}"
                name="{{ option_id }}"
                value="{{ value | escape }}"
                data-option-value-id="{{ value.id }}"
                {% if value.selected %}
                  checked
                {% endif %}
              >
              <label
                class="variant-picker__value{% unless value.available %} variant-picker__value--unavailable{% endunless %}"
                for="{{ value_id }}"
              >
                {%- if has_swatches -%}
                  {%- liquid
                    assign swatch_style = ''
                    if value.swatch.image
                      assign swatch_image_url = value.swatch.image | image_url: width: 80
                      assign swatch_style = 'background-image: url(' | append: swatch_image_url | append: ');'
                    elsif value.swatch.color
                      assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                    endif
                  -%}
                  <span class="swatch" style="{{ swatch_style }}"></span>
                  {%- if block.settings.swatch_style == 'labeled' -%}
                    <span class="variant-picker__swatch-name">{{ value }}</span>
                  {%- else -%}
                    <span class="visually-hidden">{{ value }}</span>
                  {%- endif -%}
                {%- else -%}
                  {{- value -}}
                {%- endif -%}
                {%- unless value.available -%}
                  <span class="visually-hidden">, {{ 'product.price.sold_out' | t }}</span>
                {%- endunless -%}
              </label>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endif -%}
    {%- endfor -%}

    {%- if has_size_guide -%}
      <dialog class="drawer color-{{ section.settings.color_scheme }}" id="{{ size_guide_dialog_id }}" aria-labelledby="{{ size_guide_dialog_id }}-title" scroll-lock>
        <div class="drawer__header">
          <h2 class="drawer__title" id="{{ size_guide_dialog_id }}-title">{{ size_guide_page.title }}</h2>
          <button class="button-unstyled" type="button" data-dialog-close>
            {% render 'icon', name: 'close' %}
            <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
          </button>
        </div>
        <div class="drawer__body rte">{{ size_guide_page.content }}</div>
      </dialog>
    {%- endif -%}
  </div>
{%- endunless -%}

{% stylesheet %}
  .variant-picker {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .variant-picker__option {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .variant-picker__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .variant-picker__option--fieldset {
    position: relative;
  }

  .variant-picker__option--fieldset .variant-picker__guide {
    position: absolute;
    top: 0;
    right: 0;
  }

  .variant-picker__option--fieldset:has(.variant-picker__guide) .variant-picker__label {
    padding-inline-end: 96px;
  }

  .variant-picker__label {
    padding: 0;
    font-size: var(--font-small-size);
    line-height: 20px;
  }

  .variant-picker__guide {
    min-height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: var(--font-small-size);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .variant-picker__values {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    clear: both;
  }

  .variant-picker__value {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    padding: 0 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    font-size: var(--font-small-size);
    cursor: pointer;
    transition: border-color var(--duration-short) var(--ease);
  }

  .variant-picker__value:hover {
    border-color: var(--color-text);
  }

  .variant-picker__input:checked + .variant-picker__value {
    border-color: var(--color-text);
    background-color: var(--color-text);
    color: var(--color-background);
  }

  .variant-picker__input:focus-visible + .variant-picker__value {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .variant-picker__value--unavailable {
    border-style: dashed;
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .variant-picker__input:checked + .variant-picker__value--unavailable {
    background-color: transparent;
    color: var(--color-text-muted);
  }

  .variant-picker__values--swatches {
    gap: 8px;
  }

  .variant-picker__values--circle .variant-picker__value {
    min-width: var(--touch-target);
    padding: 0;
    border-color: transparent;
    border-radius: 9999px;
  }

  .variant-picker__values--circle .variant-picker__input:checked + .variant-picker__value {
    border-color: var(--color-text);
    background-color: transparent;
  }

  .variant-picker__values--labeled .variant-picker__input:checked + .variant-picker__value {
    background-color: transparent;
    color: var(--color-text);
  }

  .variant-picker__value--unavailable .swatch {
    opacity: 0.4;
  }

  .variant-picker--dropdown .field {
    max-width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.variant_picker.name",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.variant_picker.style",
      "options": [
        {
          "value": "buttons",
          "label": "t:blocks.variant_picker.style_buttons"
        },
        {
          "value": "dropdown",
          "label": "t:blocks.variant_picker.style_dropdown"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:blocks.variant_picker.show_swatches",
      "info": "t:blocks.variant_picker.show_swatches_info",
      "default": true
    },
    {
      "type": "select",
      "id": "swatch_style",
      "label": "t:blocks.variant_picker.swatch_style",
      "options": [
        {
          "value": "circle",
          "label": "t:blocks.variant_picker.swatch_style_circle"
        },
        {
          "value": "labeled",
          "label": "t:blocks.variant_picker.swatch_style_labeled"
        }
      ],
      "default": "circle",
      "visible_if": "{{ block.settings.show_swatches }}"
    },
    {
      "type": "header",
      "content": "t:blocks.variant_picker.size_guide_header"
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "t:blocks.variant_picker.size_guide_page",
      "info": "t:blocks.variant_picker.size_guide_page_info"
    },
    {
      "type": "text",
      "id": "size_guide_options",
      "label": "t:blocks.variant_picker.size_guide_options",
      "info": "t:blocks.variant_picker.size_guide_options_info",
      "default": "Size"
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "t:blocks.variant_picker.size_guide_label",
      "default": "Size guide"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.variant_picker.name"
    }
  ]
}
{% endschema %}
