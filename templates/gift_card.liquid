{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}

    <style>
      .gift-card { display: flex; justify-content: center; padding: 48px var(--page-margin); }
      .gift-card__inner { display: flex; flex-direction: column; align-items: center; gap: 24px; width: min(100%, 520px); text-align: center; }
      .gift-card__logo { width: 160px; height: auto; }
      .gift-card__card { display: flex; flex-direction: column; align-items: center; gap: 16px; width: 100%; padding: 32px 24px; border-radius: var(--radius-media); background-color: var(--color-tile); }
      .gift-card__balance { font-size: var(--font-display-size); line-height: 1; }
      .gift-card__code-row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; }
      .gift-card__code { padding: 8px 16px; border: 1px dashed var(--color-border); border-radius: var(--radius-input); font-size: 18px; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; }
      .gift-card__qr { display: flex; justify-content: center; min-width: 120px; min-height: 120px; padding: 8px; background-color: #fff; }
      .gift-card__qr img, .gift-card__qr canvas { width: 120px; height: 120px; }
      .gift-card__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
      .gift-card__wallet img { display: block; height: 44px; width: auto; }
      @media print { .gift-card__actions, .gift-card__wallet { display: none; } }
    </style>
  </head>

  <body class="{% render 'body-classes' %}">
    <main class="gift-card">
      <div class="gift-card__inner">
        {%- if shop.brand.logo -%}
          {{ shop.brand.logo | image_url: width: 320 | image_tag: alt: shop.name, class: 'gift-card__logo' }}
        {%- else -%}
          <p class="h2">{{ shop.name }}</p>
        {%- endif -%}

        {%- assign initial_value = gift_card.initial_value | money -%}
        <h1 class="h3">{{ 'gift_card.title' | t: value: initial_value }}</h1>

        <div class="gift-card__card">
          <p class="label text-muted">{{ 'gift_card.balance' | t }}</p>
          <p class="gift-card__balance">{{ gift_card.balance | money }}</p>

          {%- if gift_card.enabled == false or gift_card.expired -%}
            <p class="label">{{ 'gift_card.expired' | t }}</p>
          {%- elsif gift_card.expires_on -%}
            {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
            <p class="text-small text-muted">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
          {%- endif -%}

          <div class="gift-card__code-row">
            <span class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</span>
            <button class="button button--secondary" type="button" data-copy-code="{{ gift_card.code }}" data-copied-label="{{ 'gift_card.copied' | t }}">
              {{- 'gift_card.copy_code' | t -}}
            </button>
          </div>

          <div class="gift-card__qr" id="GiftCardQr" data-identifier="{{ gift_card.qr_identifier }}" role="img" aria-label="{{ 'gift_card.qr_label' | t }}"></div>
        </div>

        <p class="text-small">{{ 'gift_card.use_at_checkout' | t }}</p>

        <div class="gift-card__actions">
          {%- if gift_card.pass_url -%}
            <a class="gift-card__wallet" href="{{ gift_card.pass_url }}">
              <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" alt="{{ 'gift_card.add_to_apple_wallet' | t }}" width="120" height="40" loading="lazy">
            </a>
          {%- endif -%}
          <button class="button button--secondary" type="button" onclick="window.print();">{{ 'gift_card.print' | t }}</button>
          <a class="button" href="{{ shop.url }}">{{ 'gift_card.shop_link' | t }}</a>
        </div>
      </div>
    </main>

    <script>
      window.addEventListener('DOMContentLoaded', () => {
        const qr = document.getElementById('GiftCardQr');
        if (qr && window.QRCode) {
          new window.QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120, imageAltText: qr.getAttribute('aria-label') });
        }

        document.querySelector('[data-copy-code]')?.addEventListener('click', async (event) => {
          const button = event.currentTarget;
          try {
            await navigator.clipboard.writeText(button.dataset.copyCode);
            button.textContent = button.dataset.copiedLabel;
          } catch (error) {
            console.error(error);
          }
        });
      });
    </script>
  </body>
</html>
