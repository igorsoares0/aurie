{% doc %}
  Renders the filter and sort form for a collection or search results.
  The same markup becomes a bar, a sidebar or a drawer depending on
  `layout`; on mobile it is always a drawer. Changes are applied without a
  page reload by the parent <facet-filters> element, which must wrap this
  form and every [data-facets-part] element the response replaces.

  @param {object} results - The collection or search object with filters
  @param {string} layout - One of: horizontal, vertical, drawer
  @param {string} section_id - Section id, used for unique element ids
  @param {boolean} [enable_filtering] - Show filters. Default: true
  @param {boolean} [enable_sorting] - Show the sort selector. Default: true
  @param {number} [products_count] - Number of matching products

  @example
  {% render 'facets', results: collection, layout: 'horizontal', section_id: section.id, products_count: collection.products_count %}
{% enddoc %}

{%- liquid
  assign enable_filtering = enable_filtering | default: true, allow_false: true
  assign enable_sorting = enable_sorting | default: true, allow_false: true
  assign form_id = 'FacetsForm-' | append: section_id
  assign drawer_id = 'FacetsDrawer-' | append: section_id

  assign active_count = 0
  for filter in results.filters
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor

  if results.sort_by
    assign current_sort = results.sort_by
  else
    assign current_sort = results.default_sort_by
  endif

  if layout == 'vertical'
    assign groups_open = true
  else
    assign groups_open = false
  endif
-%}

<form class="facets facets--{{ layout }}" id="{{ form_id }}" data-facets-form>
  {%- if results.terms -%}
    <input type="hidden" name="q" value="{{ results.terms | escape }}">
    <input type="hidden" name="options[prefix]" value="last">
  {%- endif -%}

  <div class="facets__toolbar">
    {%- if enable_filtering and results.filters.size > 0 -%}
      <button class="facets__open button button--secondary" type="button" data-dialog-open="{{ drawer_id }}" aria-haspopup="dialog">
        {{- 'facets.filter' | t -}}
        {%- if active_count > 0 %} ({{ active_count }}){% endif -%}
      </button>
    {%- endif -%}

    <p class="facets__count text-small text-muted" data-facets-part="count" role="status">
      {{- 'facets.product_count' | t: count: products_count -}}
    </p>

    {%- if enable_sorting -%}
      <div class="facets__sort">
        <label class="facets__sort-label label" for="SortBy-{{ section_id }}">{{ 'facets.sort' | t }}</label>
        <select class="field facets__sort-select" id="SortBy-{{ section_id }}" name="sort_by">
          {%- for option in results.sort_options -%}
            <option
              value="{{ option.value | escape }}"
              {% if option.value == current_sort %}
                selected
              {% endif %}
            >
              {{- option.name | escape -}}
            </option>
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}
  </div>

  {%- if enable_filtering and results.filters.size > 0 -%}
    <dialog class="drawer facets__drawer" id="{{ drawer_id }}" aria-labelledby="{{ drawer_id }}-title" scroll-lock>
      <div class="drawer__header facets__drawer-header">
        <h2 class="drawer__title" id="{{ drawer_id }}-title">{{ 'facets.filter' | t }}</h2>
        <button class="button-unstyled" type="button" data-dialog-close>
          {% render 'icon', name: 'close' %}
          <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
        </button>
      </div>

      <div class="facets__groups" data-facets-part="groups">
        {%- for filter in results.filters -%}
          {%- assign group_id = 'Filter-' | append: section_id | append: '-' | append: forloop.index -%}
          <details
            class="facets__group"
            id="{{ group_id }}"
            {% if groups_open %}
              open
            {% endif %}
          >
            <summary class="facets__summary label">
              <span>
                {{- filter.label | escape -}}
                {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
              </span>
              {% render 'icon', name: 'caret' %}
            </summary>

            <div class="facets__panel">
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  {%- liquid
                    assign min_value = filter.min_value.value | money_without_currency | remove: ','
                    assign max_value = filter.max_value.value | money_without_currency | remove: ','
                    assign range_max = filter.range_max | money_without_currency | remove: ','
                  -%}
                  <div class="facets__price">
                    <label class="facets__price-field">
                      <span class="text-caption text-muted">{{ 'facets.from' | t }} ({{ cart.currency.symbol }})</span>
                      <input
                        class="field"
                        type="number"
                        inputmode="decimal"
                        name="{{ filter.min_value.param_name }}"
                        {% if filter.min_value.value %}
                          value="{{ min_value }}"
                        {% endif %}
                        placeholder="0"
                        min="0"
                        max="{{ range_max }}"
                      >
                    </label>
                    <label class="facets__price-field">
                      <span class="text-caption text-muted">{{ 'facets.to' | t }} ({{ cart.currency.symbol }})</span>
                      <input
                        class="field"
                        type="number"
                        inputmode="decimal"
                        name="{{ filter.max_value.param_name }}"
                        {% if filter.max_value.value %}
                          value="{{ max_value }}"
                        {% endif %}
                        placeholder="{{ range_max }}"
                        min="0"
                        max="{{ range_max }}"
                      >
                    </label>
                  </div>
                {%- else -%}
                  {%- assign has_swatches = false -%}
                  {%- if filter.presentation == 'swatch' or filter.values.first.swatch -%}
                    {%- assign has_swatches = true -%}
                  {%- endif -%}
                  <fieldset class="facets__values{% if has_swatches %} facets__values--swatches{% endif %}">
                    <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                    {%- for value in filter.values -%}
                      {%- assign input_id = group_id | append: '-' | append: forloop.index -%}
                      <input
                        class="facets__input visually-hidden"
                        type="checkbox"
                        id="{{ input_id }}"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        {% if value.active %}
                          checked
                        {% endif %}
                        {% if value.count == 0 and value.active == false %}
                          disabled
                        {% endif %}
                      >
                      <label class="facets__value" for="{{ input_id }}">
                        {%- if has_swatches -%}
                          {%- liquid
                            assign swatch_style = ''
                            if value.swatch.image
                              assign swatch_image_url = value.swatch.image | image_url: width: 60
                              assign swatch_style = 'background-image: url(' | append: swatch_image_url | append: ');'
                            elsif value.swatch.color
                              assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                            endif
                          -%}
                          <span class="swatch facets__swatch" style="{{ swatch_style }}"></span>
                        {%- else -%}
                          <span class="facets__check" aria-hidden="true"></span>
                        {%- endif -%}
                        <span class="facets__value-label">{{ value.label | escape }}</span>
                        <span class="facets__value-count">({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  </fieldset>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      </div>

      <div class="facets__drawer-footer">
        <a class="button button--secondary" href="{{ results.url }}{% if results.terms %}?q={{ results.terms | url_encode }}{% endif %}" data-facets-clear>
          {{- 'facets.clear_all' | t -}}
        </a>
        <button class="button" type="button" data-dialog-close>
          {{- 'facets.show_results' | t -}}
        </button>
      </div>
    </dialog>
  {%- endif -%}

  <div class="facets__active" data-facets-part="active">
    {%- if active_count > 0 -%}
      <ul class="facets__active-list" role="list">
        {%- for filter in results.filters -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != null or filter.max_value.value != null -%}
              <li>
                <a class="facets__pill" href="{{ filter.url_to_remove }}" data-facets-link>
                  {{- filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money -}}
                  {% render 'icon', name: 'close' %}
                  <span class="visually-hidden">{{ 'facets.remove' | t }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- else -%}
            {%- for value in filter.active_values -%}
              <li>
                <a class="facets__pill" href="{{ value.url_to_remove }}" data-facets-link>
                  {{- value.label | escape -}}
                  {% render 'icon', name: 'close' %}
                  <span class="visually-hidden">{{ 'facets.remove' | t }}</span>
                </a>
              </li>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        <li>
          <a class="facets__clear" href="{{ results.url }}{% if results.terms %}?q={{ results.terms | url_encode }}{% endif %}" data-facets-link>
            {{- 'facets.clear_all' | t -}}
          </a>
        </li>
      </ul>
    {%- endif -%}
  </div>
</form>

{% stylesheet %}
  .facets {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .facets__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  .facets__count {
    flex: 1 1 auto;
  }

  .facets__sort {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .facets__sort-select {
    width: auto;
    font-size: max(15px, var(--font-small-size));
  }

  .facets__groups {
    padding: 8px 24px 24px;
  }

  .facets__group {
    border-bottom: 1px solid var(--color-divider);
  }

  .facets__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 52px;
    cursor: pointer;
    list-style: none;
  }

  .facets__summary::-webkit-details-marker {
    display: none;
  }

  .facets__summary .icon {
    width: 16px;
    height: 16px;
    transition: transform var(--duration-short) var(--ease);
  }

  .facets__group[open] > .facets__summary .icon {
    transform: rotate(180deg);
  }

  .facets__panel {
    padding-bottom: 16px;
  }

  .facets__values {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .facets__value {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 40px;
    font-size: 14px;
    cursor: pointer;
  }

  .facets__value-label {
    flex: 1;
  }

  .facets__value-count {
    font-size: var(--font-caption-size);
    color: var(--color-text-muted);
  }

  .facets__check {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-input) / 4);
  }

  .shape--pill .facets__check {
    border-radius: 4px;
  }

  .facets__input:checked + .facets__value .facets__check {
    border-color: var(--color-text);
    background-color: var(--color-text);
    box-shadow: inset 0 0 0 3px var(--color-background);
  }

  .facets__input:checked + .facets__value .facets__swatch {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-text);
  }

  .facets__input:focus-visible + .facets__value {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .facets__input:disabled + .facets__value {
    color: var(--color-text-muted);
    cursor: not-allowed;
  }

  .facets__price {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .facets__price-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .facets__drawer-footer {
    position: sticky;
    bottom: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 16px 24px;
    border-top: 1px solid var(--color-divider);
    background-color: var(--color-background);
  }

  .facets__active:empty {
    display: none;
  }

  .facets__active-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
  }

  .facets__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    font-size: var(--font-small-size);
    text-decoration: none;
  }

  .facets__pill .icon {
    width: 14px;
    height: 14px;
  }

  .facets__clear {
    font-size: var(--font-small-size);
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .facets__toolbar {
      position: sticky;
      top: 0;
      z-index: 2;
      flex-wrap: nowrap;
      margin-inline: calc(var(--page-margin) * -1);
      padding: 8px var(--page-margin);
      border-bottom: 1px solid var(--color-divider);
      background-color: var(--color-background);
    }

    .facets__toolbar .facets__count {
      display: none;
    }

    .facets__open,
    .facets__sort {
      flex: 1;
    }

    /* Hidden visually only, so the sort select keeps its accessible name. */
    .facets__sort-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .facets__sort-select {
      width: 100%;
    }

    .facets--vertical .facets__drawer {
      --panel-from: translateY(100%);
      inset: auto 0 0;
      width: 100%;
      height: auto;
      max-height: 85svh;
      margin: auto 0 0;
      border-radius: 16px 16px 0 0;
    }

    .facets--horizontal .facets__drawer,
    .facets--drawer .facets__drawer {
      width: 100%;
    }
  }

  @media screen and (min-width: 990px) {
    .facets--horizontal .facets__open,
    .facets--vertical .facets__open {
      display: none;
    }

    .facets--horizontal .facets__drawer,
    .facets--vertical .facets__drawer {
      position: static;
      display: block;
      width: auto;
      height: auto;
      max-height: none;
      margin: 0;
      overflow: visible;
      background: transparent;
      color: inherit;
    }

    /* Inline on desktop, so the closed-panel offset and its transition don't apply */
    .facets--horizontal .facets__drawer:not([open]),
    .facets--vertical .facets__drawer:not([open]) {
      transform: none;
      opacity: 1;
      transition: none;
    }

    /* Horizontal filters open as dropdowns: nothing to grow, and the panel must not be clipped */
    .facets--horizontal .facets__group::details-content {
      block-size: auto;
      overflow: visible;
      opacity: 1;
      transition: none;
    }

    .facets--horizontal .facets__drawer-header,
    .facets--horizontal .facets__drawer-footer,
    .facets--vertical .facets__drawer-header,
    .facets--vertical .facets__drawer-footer {
      display: none;
    }

    .facets--horizontal .facets__groups {
      display: flex;
      flex-wrap: wrap;
      gap: 0 32px;
      padding: 0;
    }

    .facets--horizontal .facets__group {
      position: relative;
      border: 0;
    }

    .facets--horizontal .facets__summary {
      justify-content: flex-start;
      min-height: 44px;
    }

    .facets--horizontal .facets__panel {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 3;
      min-width: 260px;
      max-height: 360px;
      overflow-y: auto;
      padding: 16px;
      border: 1px solid var(--color-divider);
      background-color: var(--color-background);
    }

    .facets--horizontal {
      padding-block: 8px;
      border-top: 1px solid var(--color-divider);
      border-bottom: 1px solid var(--color-divider);
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: 32px;
    }

    .facets--horizontal .facets__toolbar {
      grid-column: 2;
      grid-row: 1;
    }

    .facets--horizontal .facets__drawer {
      grid-column: 1;
      grid-row: 1;
    }

    .facets--horizontal .facets__active {
      grid-column: 1 / -1;
      padding-top: 8px;
    }

    .facets--vertical .facets__groups {
      padding: 0;
    }

    .facets--vertical .facets__group {
      border-bottom: 0;
      border-top: 1px solid var(--color-divider);
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('facet-filters')) {
    customElements.define(
      'facet-filters',
      class FacetFilters extends HTMLElement {
        connectedCallback() {
          this.addEventListener('change', (event) => {
            const form = event.target.closest('[data-facets-form]');
            if (!form) return;
            clearTimeout(this.debounce);
            const delay = event.target.type === 'number' ? 600 : 0;
            this.debounce = setTimeout(() => this.submitForm(form), delay);
          });

          this.addEventListener('submit', (event) => {
            const form = event.target.closest('[data-facets-form]');
            if (!form) return;
            event.preventDefault();
            this.submitForm(form);
          });

          this.addEventListener('click', (event) => {
            const link = event.target.closest('[data-facets-link], [data-facets-clear]');
            if (link) {
              event.preventDefault();
              this.render(new URL(link.href, window.location.origin));
              return;
            }

            const more = event.target.closest('[data-load-more]');
            if (more) {
              event.preventDefault();
              this.loadMore(more);
            }
          });

          window.addEventListener('popstate', () => this.render(new URL(window.location.href), { push: false }));
        }

        submitForm(form) {
          const params = new URLSearchParams();
          new FormData(form).forEach((value, key) => {
            if (value !== '') params.append(key, value);
          });
          const url = new URL(window.location.pathname, window.location.origin);
          url.search = params.toString();
          this.render(url);
        }

        async fetchSection(url) {
          const fetchUrl = new URL(url);
          fetchUrl.searchParams.set('section_id', this.dataset.section);
          this.abortController?.abort();
          this.abortController = new AbortController();
          const response = await fetch(fetchUrl, { signal: this.abortController.signal });
          const html = new DOMParser().parseFromString(await response.text(), 'text/html');
          return html.querySelector(`facet-filters[data-section="${this.dataset.section}"]`);
        }

        async render(url, { push = true } = {}) {
          const activeId = document.activeElement?.id;
          const openGroups = [...this.querySelectorAll('.facets__group[open]')].map((group) => group.id);
          this.setAttribute('aria-busy', 'true');

          try {
            const next = await this.fetchSection(url);
            if (!next) return;

            this.querySelectorAll('[data-facets-part]').forEach((part) => {
              const replacement = next.querySelector(`[data-facets-part="${part.dataset.facetsPart}"]`);
              if (replacement) part.replaceWith(replacement);
            });

            const openButton = next.querySelector('.facets__open');
            if (openButton) this.querySelector('.facets__open')?.replaceChildren(...openButton.childNodes);

            this.querySelectorAll('.facets__group').forEach((group) => {
              if (openGroups.includes(group.id)) group.setAttribute('open', '');
            });

            if (activeId) document.getElementById(activeId)?.focus();
            if (push) window.history.pushState({}, '', url.toString());
          } catch (error) {
            if (error.name !== 'AbortError') console.error(error);
          } finally {
            this.removeAttribute('aria-busy');
          }
        }

        async loadMore(link) {
          link.setAttribute('aria-disabled', 'true');
          try {
            const next = await this.fetchSection(new URL(link.href, window.location.origin));
            const grid = this.querySelector('[data-product-grid]');
            const nextGrid = next?.querySelector('[data-product-grid]');
            if (!grid || !nextGrid) return;

            const firstNew = nextGrid.firstElementChild;
            grid.append(...nextGrid.children);
            this.querySelector('[data-load-more-wrapper]')?.replaceWith(
              next.querySelector('[data-load-more-wrapper]') ?? document.createTextNode('')
            );
            firstNew?.querySelector('a')?.focus();
          } catch (error) {
            if (error.name !== 'AbortError') console.error(error);
            link.removeAttribute('aria-disabled');
          }
        }
      }
    );
  }
{% endjavascript %}
