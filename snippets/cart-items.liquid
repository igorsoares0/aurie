{% doc %}
  Renders the cart line items: image, title, options, properties, selling
  plan, line discounts, unit price, lead time, quantity and remove link.
  Used by the cart page and the cart drawer. Quantity changes and removals
  are sent to the Cart API by the parent <cart-items> element, which then
  re-renders the sections listed in its `data-sections` attribute.

  @param {string} form_id - Id of the cart form the quantity inputs belong to
  @param {string} [context] - 'page' or 'drawer'. Default: 'page'

  @example
  {% render 'cart-items', form_id: 'CartForm', context: 'page' %}
{% enddoc %}

{%- liquid
  assign context = context | default: 'page'
  assign lead_time_key = settings.cart_lead_time_metafield | split: '.'

  case settings.card_style
    when 'square'
      assign image_ratio = '1 / 1'
    when 'framed'
      assign image_ratio = '4 / 3'
    else
      assign image_ratio = '3 / 4'
  endcase
-%}

<ul class="cart-items cart-items--{{ context }}" role="list" style="--line-image-ratio: {{ image_ratio }};">
  {%- for item in cart.items -%}
    <li class="cart-item" id="CartItem-{{ context }}-{{ forloop.index }}">
      <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{
            item.image
            | image_url: width: 320
            | image_tag: widths: '160, 240, 320', sizes: '160px', loading: 'lazy', alt: '', class: 'cart-item__image'
          }}
        {%- endif -%}
      </a>

      <div class="cart-item__details">
        <div class="cart-item__row">
          <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
          <div class="cart-item__total">
            {%- if item.original_line_price != item.final_line_price -%}
              <span class="visually-hidden">{{ 'product.price.regular_price' | t }}</span>
              <s class="text-muted">{{ item.original_line_price | money }}</s>
              <span class="visually-hidden">{{ 'product.price.sale_price' | t }}</span>
            {%- endif -%}
            <span>{{ item.final_line_price | money }}</span>
          </div>
        </div>

        {%- capture item_meta -%}
          {%- unless item.product.has_only_default_variant -%}
            {%- for option in item.options_with_values -%}
              {{- option.value -}}
              {%- unless forloop.last %} · {% endunless -%}
            {%- endfor -%}
          {%- endunless -%}
        {%- endcapture -%}
        <p class="cart-item__meta">
          {%- if item_meta != blank -%}
            {{ item_meta }} ·
          {% endif -%}
          {%- assign each_price = item.final_price | money -%}
          {{ 'cart.each' | t: price: each_price }}
        </p>

        {%- if item.unit_price_measurement -%}
          <p class="cart-item__meta">
            {{- item.unit_price | money }}/
            {%- if item.unit_price_measurement.reference_value != 1 -%}
              {{- item.unit_price_measurement.reference_value -}}
            {%- endif -%}
            {{- item.unit_price_measurement.reference_unit -}}
          </p>
        {%- endif -%}

        {%- for property in item.properties -%}
          {%- assign property_first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and property_first_char != '_' -%}
            <p class="cart-item__property">
              {{- property.first }}:
              {% if property.last contains '/uploads/' -%}
                <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
              {%- else -%}
                {{- property.last -}}
              {%- endif -%}
            </p>
          {%- endif -%}
        {%- endfor -%}

        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}

        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">
            {{- discount.discount_application.title }} (−{{ discount.amount | money }})
          </p>
        {%- endfor -%}

        {%- assign lead_time = item.product.metafields[lead_time_key.first][lead_time_key.last].value -%}
        {%- if lead_time != blank -%}
          <p class="cart-item__lead-time">{{ lead_time }}</p>
        {%- endif -%}

        <div class="cart-item__actions">
          {%- assign quantity_id = 'Quantity-' | append: context | append: '-' | append: forloop.index -%}
          {%- assign quantity_label = 'cart.quantity_for' | t: title: item.product.title -%}
          {% render 'quantity-input',
            id: quantity_id,
            name: 'updates[]',
            value: item.quantity,
            min: 0,
            max: item.variant.quantity_rule.max,
            step: item.variant.quantity_rule.increment,
            label: quantity_label,
            form_id: form_id,
            line: forloop.index
          %}
          <a class="cart-item__remove" href="{{ item.url_to_remove }}" data-cart-remove="{{ forloop.index }}">
            {{- 'cart.remove' | t -}}
            <span class="visually-hidden">{{ item.product.title }}</span>
          </a>
        </div>

        <p class="cart-item__error text-small" id="CartItemError-{{ context }}-{{ forloop.index }}" role="alert" hidden></p>
      </div>
    </li>
  {%- endfor -%}
</ul>

{% stylesheet %}
  .cart-items {
    margin: 0;
    border-top: 1px solid var(--color-divider);
  }

  .cart-item {
    display: flex;
    gap: 20px;
    padding-block: 24px;
    border-bottom: 1px solid var(--color-divider);
  }

  .cart-item__media {
    flex: none;
    width: 120px;
    overflow: hidden;
    aspect-ratio: var(--line-image-ratio);
    border-radius: calc(var(--radius-media) / 2);
    background-color: var(--color-tile);
  }

  .cart-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__details {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cart-item__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: var(--font-small-size);
    line-height: 20px;
  }

  .cart-item__title {
    text-decoration: none;
  }

  .cart-item__total {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 8px;
    white-space: nowrap;
  }

  .cart-item__meta,
  .cart-item__property,
  .cart-item__plan,
  .cart-item__discount,
  .cart-item__lead-time {
    font-size: var(--font-caption-size);
    line-height: 18px;
  }

  .cart-item__meta {
    color: var(--color-text-muted);
  }

  .cart-item__plan,
  .cart-item__discount {
    color: var(--color-accent);
  }

  .cart-item__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: auto;
    padding-top: 8px;
  }

  .cart-item__remove {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-size: var(--font-caption-size);
    text-underline-offset: 3px;
  }

  .cart-item__error {
    color: var(--color-error);
  }

  .card--framed .cart-items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 0;
  }

  .card--framed .cart-item {
    padding: 20px;
    border-bottom: 0;
    border-radius: var(--radius-media);
    background-color: var(--color-tile);
  }

  .card--framed .cart-item__media {
    width: 160px;
    background-color: var(--color-background);
  }

  .cart-items--drawer .cart-item__media {
    width: 88px;
  }

  @media screen and (max-width: 749px) {
    .cart-item__media,
    .card--framed .cart-item__media {
      width: 96px;
    }

    .card--framed .cart-item {
      padding: 16px;
    }
  }
{% endstylesheet %}
