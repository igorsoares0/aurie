{% doc %}
  Renders a product card as a plate of the catalog: the image in a frame, the
  catalog number in its corner, optional dimension lines along its edges, then
  the name, price and a details line. Its proportions follow the global "Card
  style" setting and the details line follows "Card details".

  In a grid marked as an index (.product-grid--index), the same card reads as a
  row of a table: number, image, name, the columns passed in index_columns, the
  option codes and the price.

  @param {product} product - The product to show
  @param {string} [sizes] - The image sizes attribute. Default: a 4-column grid
  @param {boolean} [eager] - Load the image eagerly, for cards above the fold
  @param {boolean} [priority] - Also fetch the image first, for the card that is likely the largest paint
  @param {string} [heading_tag] - Tag for the product name. Default: 'h3'
  @param {string} [index_columns] - Columns for the index view, as "Label: namespace.key" pairs separated by commas, such as "W: custom.width, D: custom.depth"
  @param {boolean} [show_index] - Render the index data (type, metafield columns, option codes and price) for the index view. Default: true when index_columns is set

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}
  {% render 'product-card', product: product, index_columns: 'W: custom.width, D: custom.depth, H: custom.height' %}
{% enddoc %}

{%- liquid
  assign card_style = settings.card_style
  assign details = settings.card_details
  assign heading_tag = heading_tag | default: 'h3'
  assign image_sizes = sizes | default: '(min-width: 990px) calc((100vw - 96px) / 4), (min-width: 750px) calc((100vw - 64px) / 3), calc((100vw - 36px) / 2)'

  case settings.card_image_ratio
    when 'portrait'
      assign ratio = '3 / 4'
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      case card_style
        when 'square'
          assign ratio = '1 / 1'
        when 'framed'
          assign ratio = '4 / 3'
        else
          assign ratio = '3 / 4'
      endcase
  endcase

  if eager
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif

  assign fetch_priority = 'auto'
  if priority
    assign fetch_priority = 'high'
  endif

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign secondary_media = nil
  if settings.card_secondary_image and product.media.size > 1
    assign secondary_media = product.media[1]
  endif

  assign size_option_names = settings.card_size_option | downcase | split: ','
  assign swatch_option = blank
  assign size_option = blank
  for option in product.options_with_values
    assign option_key = option.name | downcase | strip
    if swatch_option == blank and option.values.first.swatch
      assign swatch_option = option
    endif
    for size_name in size_option_names
      assign size_name_key = size_name | strip
      if size_name_key == option_key
        assign size_option = option
      endif
    endfor
  endfor

  assign spec_text = blank
  if details == 'material'
    assign material_key = settings.card_material_metafield | split: '.'
    assign spec_text = product.metafields[material_key.first][material_key.last].value
  elsif details == 'dimensions'
    assign dimensions_key = settings.card_dimensions_metafield | split: '.'
    assign spec_text = product.metafields[dimensions_key.first][dimensions_key.last].value
  endif

  assign catalog_number = blank
  if settings.catalog_number_metafield != blank
    assign catalog_key = settings.catalog_number_metafield | split: '.'
    assign catalog_number = product.metafields[catalog_key.first][catalog_key.last].value
  endif

  assign dimension_width = blank
  assign dimension_height = blank
  if settings.card_dimension_lines
    if settings.dimension_width_metafield != blank
      assign width_key = settings.dimension_width_metafield | split: '.'
      assign dimension_width = product.metafields[width_key.first][width_key.last].value
    endif
    if settings.dimension_height_metafield != blank
      assign height_key = settings.dimension_height_metafield | split: '.'
      assign dimension_height = product.metafields[height_key.first][height_key.last].value
    endif
  endif

  assign index_pairs = index_columns | default: '' | split: ','
  assign code_option = blank
  assign show_index_data = show_index | default: false, allow_false: true
  if index_columns != blank
    assign show_index_data = true
  endif
  if show_index_data
    comment
      The index lists the codes of the first option that has a code letter, such as Fabric or Finish
    endcomment
    for option in product.options_with_values
      capture first_code
        render 'option-code', option_name: option.name, position: 1
      endcapture
      if first_code != blank
        assign code_option = option
        break
      endif
    endfor
  endif
-%}

<article class="product-card product-card--{{ card_style }}" style="--card-ratio: {{ ratio }};">
  <div class="product-card__media">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 1200
        | image_tag:
          widths: '300, 450, 600, 800, 1000, 1200',
          sizes: image_sizes,
          loading: loading,
          fetchpriority: fetch_priority,
          alt: product.featured_media.alt,
          class: 'product-card__image'
      }}
      {%- if secondary_media -%}
        {{
          secondary_media
          | image_url: width: 1200
          | image_tag:
            widths: '300, 450, 600, 800, 1000, 1200',
            sizes: image_sizes,
            loading: 'lazy',
            alt: '',
            class: 'product-card__image product-card__image--secondary'
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
    {%- endif -%}

    {%- if dimension_width != blank -%}
      <span class="dim dim--width" aria-hidden="true">
        <span class="dim__label">
          {%- unless dimension_width contains 'Ø' -%}
            {{ 'product.media.width_short' | t }}
          {% endunless -%}
          {{- dimension_width -}}
        </span>
      </span>
    {%- endif -%}
    {%- if dimension_height != blank -%}
      <span class="dim dim--height" aria-hidden="true">
        <span class="dim__label">{{ 'product.media.height_short' | t }} {{ dimension_height }}</span>
      </span>
    {%- endif -%}

    {%- if product.available == false -%}
      <span class="product-card__badge label">{{ 'product.price.sold_out' | t }}</span>
    {%- elsif on_sale -%}
      <span class="product-card__badge product-card__badge--sale label">{{ 'product.price.sale' | t }}</span>
    {%- endif -%}
  </div>

  {%- if catalog_number != blank -%}
    <span class="product-card__no figure-caption">{{ 'product.catalog_number' | t: number: catalog_number }}</span>
  {%- endif -%}

  <div class="product-card__info">
    <div class="product-card__row">
      <{{ heading_tag }} class="product-card__name">
        <a class="product-card__link" href="{{ product.url }}">{{ product.title }}</a>
      </{{ heading_tag }}>
      {% render 'price', product: product, class: 'product-card__price' %}
    </div>

    {%- if show_index_data and product.type != blank -%}
      <span class="product-card__type text-small text-muted">{{ product.type }}</span>
    {%- endif -%}

    {%- if spec_text != blank -%}
      <p class="product-card__spec">{{ spec_text }}</p>
    {%- endif -%}

    {%- if details == 'sizes' and size_option != blank -%}
      {%- assign size_variant_key = 'option' | append: size_option.position -%}
      <ul class="product-card__sizes" role="list" aria-label="{{ 'product.card.available_sizes' | t }}">
        {%- for value in size_option.values -%}
          {%- liquid
            assign value_text = value | append: ''
            assign available_variants = product.variants | where: size_variant_key, value_text | where: 'available', true
          -%}
          {%- if available_variants.size > 0 -%}
            <li>{{ value }}</li>
          {%- else -%}
            <li class="product-card__size--unavailable">
              <s>{{ value }}</s>
              <span class="visually-hidden">{{ 'product.price.sold_out' | t }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- elsif swatch_option != blank -%}
      <div class="product-card__swatches">
        <ul class="product-card__swatch-list" role="list">
          {%- for value in swatch_option.values limit: 5 -%}
            {%- liquid
              assign swatch_style = ''
              if value.swatch.image
                assign swatch_image_url = value.swatch.image | image_url: width: 60
                assign swatch_style = 'background-image: url(' | append: swatch_image_url | append: ');'
              elsif value.swatch.color
                assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
              endif
            -%}
            {%- assign swatch_variant = value.variant | default: product.selected_or_first_available_variant -%}
            {%- assign swatch_media = swatch_variant.featured_media -%}
            <li>
              <button
                class="product-card__swatch-button touch-area"
                type="button"
                aria-label="{{ swatch_option.name | escape }}: {{ value | escape }}"
                aria-pressed="{% if value.selected %}true{% else %}false{% endif %}"
                data-card-swatch
                data-label="{{ value | escape }}"
                data-variant-url="{{ swatch_variant.url | default: product.url }}"
                {% if swatch_media %}
                  data-src="{{ swatch_media | image_url: width: 800 }}"
                  data-srcset="{{ swatch_media | image_url: width: 300 }} 300w, {{ swatch_media | image_url: width: 600 }} 600w, {{ swatch_media | image_url: width: 900 }} 900w, {{ swatch_media | image_url: width: 1200 }} 1200w"
                  data-focal-point="{{ swatch_media.preview_image.presentation.focal_point }}"
                {% endif %}
              >
                <span class="swatch product-card__swatch" style="{{ swatch_style }}"></span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
        {%- if swatch_option.values.size == 1 -%}
          <span class="product-card__swatch-label">{{ swatch_option.values.first }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if show_index_data -%}
    {%- comment -%} The columns of the index view. Hidden in the plate view. {%- endcomment -%}
    <dl class="product-card__columns">
      {%- for pair in index_pairs -%}
        {%- liquid
          assign pair_parts = pair | split: ':'
          assign column_label = pair_parts.first | strip
          assign column_key = pair_parts.last | strip | split: '.'
          assign column_value = product.metafields[column_key.first][column_key.last].value
        -%}
        <div class="product-card__column">
          <dt class="product-card__column-label label">{{ column_label }}</dt>
          <dd class="mono">{{ column_value | default: '—' }}</dd>
        </div>
      {%- endfor -%}
      <div class="product-card__column product-card__column--options">
        <dt class="product-card__column-label label">{{ 'product.card.options' | t }}</dt>
        <dd class="mono">
          {%- if code_option != blank -%}
            {%- for value in code_option.values -%}
              <span class="product-card__code">
                {%- render 'option-code', option_name: code_option.name, position: forloop.index -%}
              </span>
              {%- unless forloop.last %} · {% endunless -%}
            {%- endfor -%}
          {%- elsif swatch_option != blank -%}
            {{ swatch_option.values.size }} × {{ swatch_option.name }}
          {%- elsif size_option != blank -%}
            {{ size_option.values | join: ' ' }}
          {%- else -%}
            —
          {%- endif -%}
        </dd>
      </div>
      <div class="product-card__column product-card__column--price">
        <dt class="visually-hidden">{{ 'product.price.regular_price' | t }}</dt>
        <dd>{% render 'price', product: product, class: 'product-card__price' %}</dd>
      </div>
    </dl>
  {%- endif -%}
</article>

{% stylesheet %}
  /** The plate: image in a hairline frame, number in the corner, details below */
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    container: product-card / inline-size;
  }

  /* A narrow plate stacks the price under the name */
  @container product-card (max-width: 280px) {
    .product-card__row {
      flex-direction: column;
      gap: 0;
    }

    .product-card__price {
      white-space: normal;
    }
  }

  .product-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--card-ratio);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-media);
    background-color: var(--color-tile);
  }

  .product-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--duration-medium) var(--ease);
  }

  .product-card__image--secondary {
    opacity: 0;
  }

  /* The hover image belongs to the first color: it stays hidden while the pointer is
     on the swatches, so a new color shows at once, and once another color is picked */
  @media (hover: hover) {
    .product-card:hover:not(:has(.product-card__swatches:hover), [data-swatch-picked]) .product-card__image--secondary {
      opacity: 1;
    }
  }

  /* Framed plates show the whole object on the frame's color, as in a catalog */
  .product-card--framed .product-card__image {
    inset: 7% 13% 13% 7%;
    width: 80%;
    height: 80%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .product-card__media .dim {
    --dim-label-background: var(--color-tile);
  }

  .product-card__no {
    position: absolute;
    top: 9px;
    left: 11px;
    z-index: 1;
    pointer-events: none;
  }

  .product-card__badge {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 2px 6px;
    background-color: var(--color-background);
    color: var(--color-text-muted);
  }

  .product-card__badge--sale {
    color: var(--color-accent);
  }

  .product-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .product-card__name {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 17px;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
  }

  .product-card__link {
    text-decoration: none;
  }

  .product-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .product-card__link:focus-visible {
    outline: none;
  }

  .product-card:has(.product-card__link:focus-visible) {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .product-card__price {
    flex-shrink: 0;
    gap: 2px 8px;
    font-size: var(--font-small-size);
    line-height: 20px;
    white-space: nowrap;
  }

  .product-card__price .price__unit {
    white-space: normal;
  }

  .product-card__spec,
  .product-card__swatch-label,
  .product-card__sizes {
    font-family: var(--font-label-family);
    font-size: var(--font-caption-size);
    line-height: 16px;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .product-card__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    margin: 0;
    color: var(--color-text);
  }

  .product-card__size--unavailable {
    color: var(--color-text-muted);
  }

  .product-card__swatches {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .product-card__swatch-list {
    display: flex;
    gap: 0;
    margin: 0 0 0 -7px;
  }

  .product-card__swatch-button {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    cursor: pointer;
  }

  .product-card__swatch-button[aria-pressed='true'] .product-card__swatch {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-text);
  }

  .product-card__swatch {
    width: 14px;
    height: 14px;
  }

  /* Index data shows only in an index grid */
  .product-card__columns,
  .product-card__type {
    display: none;
  }

  .product-card__columns {
    margin: 0;
  }

  .product-card__column dd {
    margin: 0;
  }

  /** The index: the same card as a row of the catalog's table */
  .product-grid--index .product-card {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    grid-template-areas:
      'media no'
      'media info'
      'media columns';
    grid-template-rows: auto auto 1fr;
    align-content: start;
    gap: 2px 12px;
    padding-block: 12px;
    border-bottom: var(--rule-thin);
  }

  .product-grid--index .product-card__media {
    grid-area: media;
    align-self: start;
    aspect-ratio: 1;
  }

  .product-grid--index .product-card__media .dim,
  .product-grid--index .product-card__badge,
  .product-grid--index .product-card__image--secondary,
  .product-grid--index .product-card__swatches,
  .product-grid--index .product-card__sizes,
  .product-grid--index .product-card__spec {
    display: none;
  }

  .product-grid--index .product-card__no {
    position: static;
    grid-area: no;
    color: var(--color-accent);
  }

  .product-grid--index .product-card__info {
    grid-area: info;
  }

  .product-grid--index .product-card__columns {
    grid-area: columns;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    font-size: var(--font-caption-size);
  }

  .product-grid--index .product-card__column {
    display: flex;
    flex-direction: column;
  }

  .product-grid--index .product-card__column-label {
    color: var(--color-text-muted);
  }

  .product-grid--index .product-card__column--options,
  .product-grid--index .product-card__column--price {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .product-grid--index .product-card {
      grid-template-columns: var(--index-template);
      grid-template-areas: none;
      align-items: center;
      gap: 0 12px;
      padding-block: 10px;
    }

    .product-grid--index .product-card__no {
      grid-column: 1;
      grid-row: 1;
    }

    .product-grid--index .product-card__media {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: 4 / 3;
    }

    .product-grid--index .product-card__info {
      grid-column: 3;
      grid-row: 1;
    }

    .product-grid--index .product-card__name {
      font-size: 19px;
    }

    .product-grid--index .product-card__info .product-card__price {
      display: none;
    }

    .product-grid--index .product-card__type {
      display: block;
    }

    .product-grid--index .product-card__columns {
      display: contents;
    }

    /* The data columns always start after the name, with or without a catalog number */
    .product-grid--index .product-card__column:first-child {
      grid-column-start: 4;
    }

    .product-card__code {
      white-space: nowrap;
    }

    .product-grid--index .product-card__column,
    .product-grid--index .product-card__column--options,
    .product-grid--index .product-card__column--price {
      display: block;
      font-size: var(--font-small-size);
    }

    .product-grid--index .product-card__column--options {
      color: var(--color-text-muted);
    }

    .product-grid--index .product-card__column--price {
      justify-self: end;
    }

    .product-grid--index .product-card__column-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
{% endstylesheet %}
