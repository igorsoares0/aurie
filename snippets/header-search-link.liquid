{% doc %}
  Renders the header link to the search page: the word on large screens and an
  icon on small ones. The word stays available to screen readers at every size.

  @example
  {% render 'header-search-link' %}
{% enddoc %}

<a class="header__tool header__search-link" href="{{ routes.search_url }}" data-dialog-open="SearchModal" aria-haspopup="dialog">
  <span class="header__tool-icon">{% render 'icon', name: 'search' %}</span>
  <span class="header__tool-word">{{ 'header.search' | t }}</span>
</a>
