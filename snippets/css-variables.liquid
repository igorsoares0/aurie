{% doc %}
  Outputs the font faces and the CSS custom properties that every component
  reads: one class per color scheme, type, spacing and shape tokens.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{%- liquid
  assign heading_font = settings.heading_font
  assign body_font = settings.body_font
  assign body_font_medium = body_font | font_modify: 'weight', '+100'
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
  assign heading_font_italic = heading_font | font_modify: 'style', 'italic'
  assign heading_font_bold_italic = heading_font_bold | font_modify: 'style', 'italic'

  case settings.corner_style
    when 'rounded'
      assign radius_button = '8px'
      assign radius_input = '8px'
      assign radius_media = '16px'
    when 'pill'
      assign radius_button = '9999px'
      assign radius_input = '9999px'
      assign radius_media = '0px'
    else
      assign radius_button = '0px'
      assign radius_input = '0px'
      assign radius_media = '0px'
  endcase

  assign heading_scale = settings.heading_scale | divided_by: 100.0
-%}

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font_bold | font_face: font_display: 'swap' }}
  {{ heading_font_italic | font_face: font_display: 'swap' }}
  {{ heading_font_bold_italic | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_medium | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  {{ body_font_bold_italic | font_face: font_display: 'swap' }}

  :root {
    --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-style: {{ heading_font.style }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-heading-case: {{ settings.heading_case }};
    --font-heading-scale: {{ heading_scale }};
    --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-style: {{ body_font.style }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-medium: {{ body_font_medium.weight | default: body_font_bold.weight | default: 700 }};
    --font-body-weight-bold: {{ body_font_bold.weight | default: 700 }};

    --page-width: {{ settings.page_width }};
    --page-margin-desktop: {{ settings.page_margin }}px;
    --section-spacing-desktop: {{ settings.section_spacing }}px;
    --grid-gap: {{ settings.grid_gap }};

    --radius-button: {{ radius_button }};
    --radius-input: {{ radius_input }};
    --radius-media: {{ radius_media }};
  }

  {% for scheme in settings.color_schemes %}
    {%- liquid
      assign background_brightness = scheme.settings.background | color_brightness
      if background_brightness > 128
        assign color_success = '#2f5d3a'
        assign color_error = '#a12c22'
      else
        assign color_success = '#8fc79b'
        assign color_error = '#f08a7e'
      endif
    -%}
    {% if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-text: {{ scheme.settings.text }};
      --color-text-muted: {{ scheme.settings.text_muted }};
      --color-tile: {{ scheme.settings.tile }};
      --color-divider: {{ scheme.settings.divider }};
      --color-border: {{ scheme.settings.border }};
      --color-accent: {{ scheme.settings.accent }};
      --color-accent-label: {{ scheme.settings.accent_label }};
      --color-button: {{ scheme.settings.button }};
      --color-button-label: {{ scheme.settings.button_label }};
      --color-success: {{ color_success }};
      --color-error: {{ color_error }};

      background-color: var(--color-background);
      {%- if scheme.settings.background_gradient != blank %}
        background-image: {{ scheme.settings.background_gradient }};
      {%- endif %}
      color: var(--color-text);
    }
  {% endfor %}
{% endstyle %}
